diff --git a/src/llama-vram-budget.cpp b/src/llama-vram-budget.cpp
new file mode 100644
index 0000000..6acfa6c
--- /dev/null
+++ b/src/llama-vram-budget.cpp
@@ -0,0 +1,334 @@
+#include "llama-vram-budget.h"
+
+#include "llama-impl.h"
+
+#include "ggml.h"
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#if defined(_WIN32)
+    #define WIN32_LEAN_AND_MEAN
+    #ifndef NOMINMAX
+        #define NOMINMAX
+    #endif
+    #include <windows.h>
+    #include <winternl.h> // NTSTATUS, for d3dkmthk.h
+    #include <dxgi1_4.h>
+    #include <d3dkmthk.h>
+    #ifndef NT_SUCCESS
+        #define NT_SUCCESS(status) (((NTSTATUS) (status)) >= 0)
+    #endif
+#endif
+
+namespace {
+
+[[maybe_unused]] constexpr double MiB = 1024.0*1024.0; // Windows only
+
+class vram_monitor_base : public llama_vram_monitor {
+public:
+    llama_vram_snapshot latest() const override {
+        std::lock_guard<std::mutex> lock(mtx);
+        return snap;
+    }
+
+protected:
+    void publish(const llama_vram_snapshot & s) {
+        std::lock_guard<std::mutex> lock(mtx);
+        snap = s;
+    }
+
+private:
+    mutable std::mutex  mtx;
+    llama_vram_snapshot snap;
+};
+
+// cudaMemGetInfo/hipMemGetInfo, polled
+class vram_monitor_generic : public vram_monitor_base {
+public:
+    vram_monitor_generic(ggml_backend_dev_t dev, int poll_ms) : dev(dev), poll_ms(poll_ms) {
+        refresh();
+        thread = std::thread([this]() { loop(); });
+    }
+
+    ~vram_monitor_generic() override {
+        {
+            std::lock_guard<std::mutex> lock(stop_mtx);
+            stop = true;
+        }
+        cv.notify_all();
+        thread.join();
+    }
+
+    const char * source() const override { return "ggml_backend_dev_memory"; }
+
+private:
+    void refresh() {
+        llama_vram_snapshot s;
+        s.t_us = ggml_time_us(); // before the query, see vram_monitor_win::refresh
+
+        size_t free  = 0;
+        size_t total = 0;
+        ggml_backend_dev_memory(dev, &free, &total);
+
+        s.valid  = total > 0;
+        s.budget = total;
+        s.usage  = total - std::min(free, total);
+        publish(s);
+    }
+
+    void loop() {
+        std::unique_lock<std::mutex> lock(stop_mtx);
+        while (!cv.wait_for(lock, std::chrono::milliseconds(poll_ms), [&]() { return stop; })) {
+            lock.unlock();
+            refresh();
+            lock.lock();
+        }
+    }
+
+    ggml_backend_dev_t dev;
+    const int          poll_ms;
+
+    std::thread             thread;
+    std::mutex              stop_mtx;
+    std::condition_variable cv;
+    bool                    stop = false;
+};
+
+#if defined(_WIN32)
+
+// DXGI budget of this process and D3DKMT statistics of the adapter, refreshed on budget changes and every poll_ms
+class vram_monitor_win : public vram_monitor_base {
+public:
+    static std::unique_ptr<llama_vram_monitor> create(const uint8_t luid_bytes[8], uint32_t node_mask, int poll_ms) {
+        LUID luid;
+        static_assert(sizeof(luid) == 8, "LUID is 8 bytes");
+        memcpy(&luid, luid_bytes, sizeof(luid));
+
+        HMODULE dxgi = LoadLibraryW(L"dxgi.dll");
+        if (!dxgi) {
+            return nullptr;
+        }
+        using create_factory_t = HRESULT (WINAPI *)(REFIID, void **);
+        auto create_factory = (create_factory_t) GetProcAddress(dxgi, "CreateDXGIFactory1");
+
+        IDXGIFactory4 * factory = nullptr;
+        IDXGIAdapter3 * adapter = nullptr;
+        if (!create_factory || FAILED(create_factory(__uuidof(IDXGIFactory4), (void **) &factory))) {
+            FreeLibrary(dxgi);
+            return nullptr;
+        }
+        const HRESULT hr = factory->EnumAdapterByLuid(luid, __uuidof(IDXGIAdapter3), (void **) &adapter);
+        factory->Release();
+        if (FAILED(hr)) {
+            LLAMA_LOG_WARN("%s: no DXGI adapter with LUID %08lx:%08lx (0x%08lx)\n", __func__,
+                    (unsigned long) luid.HighPart, (unsigned long) luid.LowPart, (unsigned long) hr);
+            FreeLibrary(dxgi);
+            return nullptr;
+        }
+        std::unique_ptr<vram_monitor_win> m(new vram_monitor_win(dxgi, adapter, luid, node_mask, poll_ms));
+        if (!m->thread.joinable()) {
+            return nullptr;
+        }
+        return m;
+    }
+
+    ~vram_monitor_win() override {
+        if (thread.joinable()) {
+            SetEvent(ev_stop);
+            thread.join();
+        }
+        if (ev_budget) {
+            adapter->UnregisterVideoMemoryBudgetChangeNotification(cookie);
+            CloseHandle(ev_budget);
+        }
+        if (ev_stop) {
+            CloseHandle(ev_stop);
+        }
+        adapter->Release();
+        FreeLibrary(dxgi);
+    }
+
+    const char * source() const override { return "DXGI QueryVideoMemoryInfo + D3DKMTQueryStatistics"; }
+
+private:
+    vram_monitor_win(HMODULE dxgi, IDXGIAdapter3 * adapter, LUID luid, uint32_t node_mask, int poll_ms) :
+        dxgi(dxgi), adapter(adapter), luid(luid), poll_ms(poll_ms) {
+        // the node of a single-GPU adapter is 0; a linked adapter's device is the lowest bit of its node mask
+        if (node_mask > 1) {
+            while (!(node_mask & (1u << node))) {
+                node++;
+            }
+        }
+
+        ev_stop = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+        if (!ev_stop) {
+            return; // no thread: create() gives up
+        }
+        ev_budget = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+        if (ev_budget && FAILED(adapter->RegisterVideoMemoryBudgetChangeNotificationEvent(ev_budget, &cookie))) {
+            LLAMA_LOG_WARN("%s: no budget change notifications, polling every %d ms only\n", __func__, poll_ms);
+            CloseHandle(ev_budget);
+            ev_budget = nullptr;
+        }
+
+        find_local_segments();
+
+        refresh();
+        const llama_vram_snapshot s = latest();
+        LLAMA_LOG_INFO("%s: LUID %08lx:%08lx node %u: budget %.0f MiB, usage %.0f MiB (non-local %.0f MiB); adapter: %zu "
+                "local segment(s), %.0f of %.0f MiB resident\n", __func__, (unsigned long) luid.HighPart,
+                (unsigned long) luid.LowPart, node, s.budget/MiB, s.usage/MiB, s.usage_nonlocal/MiB, segments.size(),
+                s.adapter_resident/MiB, s.adapter_total/MiB);
+
+        thread = std::thread([this]() { loop(); });
+    }
+
+    // the adapter's memory segments that are not apertures into system memory
+    void find_local_segments() {
+        HMODULE gdi = LoadLibraryW(L"gdi32.dll"); // stays loaded: user32/gdi32 are loaded by every GUI-capable process
+        query_stats = gdi ? (PFND3DKMT_QUERYSTATISTICS) GetProcAddress(gdi, "D3DKMTQueryStatistics") : nullptr;
+        if (!query_stats) {
+            LLAMA_LOG_WARN("%s: no D3DKMTQueryStatistics: other processes' usage is only seen through the budget\n", __func__);
+            return;
+        }
+
+        D3DKMT_QUERYSTATISTICS q = {};
+        q.Type        = D3DKMT_QUERYSTATISTICS_ADAPTER;
+        q.AdapterLuid = luid;
+        if (!NT_SUCCESS(query_stats(&q))) {
+            query_stats = nullptr;
+            return;
+        }
+        const ULONG n_segments = q.QueryResult.AdapterInformation.NbSegments;
+        for (ULONG id = 0; id < n_segments; ++id) {
+            D3DKMT_QUERYSTATISTICS qs = {};
+            qs.Type                   = D3DKMT_QUERYSTATISTICS_SEGMENT;
+            qs.AdapterLuid            = luid;
+            qs.QuerySegment.SegmentId = id;
+            if (!NT_SUCCESS(query_stats(&qs))) {
+                continue;
+            }
+            const D3DKMT_QUERYSTATISTICS_SEGMENT_INFORMATION & si = qs.QueryResult.SegmentInformation;
+            const bool local = !si.Aperture && !si.SegmentProperties.SystemMemory;
+            LLAMA_LOG_DEBUG("%s: segment %lu: %s, commit limit %.0f MiB, resident %.0f MiB\n", __func__,
+                    (unsigned long) id, si.Aperture ? "aperture" : (local ? "local" : "system memory"),
+                    si.CommitLimit/MiB, si.BytesResident/MiB);
+            if (local) {
+                segments.push_back(id);
+            }
+        }
+    }
+
+    void refresh() {
+        llama_vram_snapshot s;
+        // stamped before the queries: a snapshot must not look newer than its data (llama_kv_pool_ctl compares it
+        // with the time of the last resize)
+        const int64_t t_us = ggml_time_us();
+
+        DXGI_QUERY_VIDEO_MEMORY_INFO local    = {};
+        DXGI_QUERY_VIDEO_MEMORY_INFO nonlocal = {};
+        if (FAILED(adapter->QueryVideoMemoryInfo(node, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &local)) ||
+            FAILED(adapter->QueryVideoMemoryInfo(node, DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL, &nonlocal))) {
+            if (!failed) {
+                LLAMA_LOG_WARN("%s: QueryVideoMemoryInfo failed, the KV pool keeps its size until it works again\n", __func__);
+            }
+            failed = true;
+            publish(s);
+            return;
+        }
+        failed = false;
+        s.budget         = local.Budget;
+        s.usage          = local.CurrentUsage;
+        s.usage_nonlocal = nonlocal.CurrentUsage;
+
+        if (query_stats && !segments.empty()) {
+            uint64_t total    = 0;
+            uint64_t resident = 0;
+            for (ULONG id : segments) {
+                D3DKMT_QUERYSTATISTICS qs = {};
+                qs.Type                   = D3DKMT_QUERYSTATISTICS_SEGMENT;
+                qs.AdapterLuid            = luid;
+                qs.QuerySegment.SegmentId = id;
+                if (!NT_SUCCESS(query_stats(&qs))) {
+                    total = 0;
+                    break;
+                }
+                total    += qs.QueryResult.SegmentInformation.CommitLimit;
+                resident += qs.QueryResult.SegmentInformation.BytesResident;
+            }
+            s.adapter_total    = total;
+            s.adapter_resident = total > 0 ? resident : 0;
+        }
+
+        s.t_us  = t_us;
+        s.valid = true;
+        publish(s);
+    }
+
+    void loop() {
+        HANDLE events[2] = { ev_stop, ev_budget };
+        while (true) {
+            const DWORD r = WaitForMultipleObjects(ev_budget ? 2 : 1, events, FALSE, (DWORD) poll_ms);
+            if (r == WAIT_OBJECT_0 || r == WAIT_FAILED) {
+                if (r == WAIT_FAILED) {
+                    LLAMA_LOG_WARN("%s: wait failed (%lu), the VRAM monitor stops\n", __func__, (unsigned long) GetLastError());
+                    publish(llama_vram_snapshot());
+                }
+                return;
+            }
+            refresh();
+        }
+    }
+
+    HMODULE         dxgi;
+    IDXGIAdapter3 * adapter;
+    const LUID      luid;
+    UINT            node = 0;
+    const int       poll_ms;
+
+    PFND3DKMT_QUERYSTATISTICS query_stats = nullptr;
+    std::vector<ULONG>        segments;
+
+    HANDLE ev_stop   = nullptr;
+    HANDLE ev_budget = nullptr;
+    DWORD  cookie    = 0;
+    bool   failed    = false;
+
+    std::thread thread;
+};
+
+#endif // _WIN32
+
+} // namespace
+
+std::unique_ptr<llama_vram_monitor> llama_vram_monitor::create(ggml_backend_dev_t dev, int poll_ms) {
+#if defined(_WIN32)
+    // bool ggml_backend_dev_get_luid(ggml_backend_dev_t dev, uint8_t luid[8], uint32_t * node_mask)
+    using get_luid_t = bool (*)(ggml_backend_dev_t, uint8_t *, uint32_t *);
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    auto get_luid = reg ? (get_luid_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_dev_get_luid") : nullptr;
+
+    uint8_t  luid[8]   = {};
+    uint32_t node_mask = 0;
+    if (get_luid && get_luid(dev, luid, &node_mask)) {
+        if (auto m = vram_monitor_win::create(luid, node_mask, poll_ms)) {
+            return m;
+        }
+    }
+    LLAMA_LOG_WARN("%s: %s: no DXGI adapter for the device; falling back to ggml_backend_dev_memory, which may not see "
+            "other processes' VRAM on Windows\n", __func__, ggml_backend_dev_name(dev));
+#endif
+    size_t free  = 0;
+    size_t total = 0;
+    ggml_backend_dev_memory(dev, &free, &total);
+    if (total == 0) {
+        return nullptr;
+    }
+    return std::make_unique<vram_monitor_generic>(dev, poll_ms);
+}
diff --git a/src/llama-vram-budget.h b/src/llama-vram-budget.h
new file mode 100644
index 0000000..e41f282
--- /dev/null
+++ b/src/llama-vram-budget.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include "llama-kv-pool-ctl.h"
+
+#include "ggml-backend.h"
+
+#include <memory>
+
+// Live VRAM budget of this process on one device [EXPERIMENTAL], for the adaptive KV stream pool
+//
+// Windows: the adapter is found by the device's LUID (the backend's "ggml_backend_dev_get_luid"); a thread takes a
+// snapshot every poll_ms, and at once when the OS signals a budget change
+// (IDXGIAdapter3::RegisterVideoMemoryBudgetChangeNotificationEvent):
+//   - budget, usage, usage_nonlocal: IDXGIAdapter3::QueryVideoMemoryInfo, local and non-local segment groups, for this
+//     process (the kernel's accounting, so it includes the HIP/CUDA allocations)
+//   - adapter_total, adapter_resident: D3DKMTQueryStatistics over the adapter's local memory segments, all processes
+//     (what Task Manager shows as dedicated GPU memory)
+// Elsewhere, or without a LUID: ggml_backend_dev_memory (cudaMemGetInfo/hipMemGetInfo) as budget = total and
+// usage = total - free. On Windows that fallback is unverified: hipMemGetInfo may not see other processes.
+class llama_vram_monitor {
+public:
+    // nullptr if the device reports no memory at all
+    static std::unique_ptr<llama_vram_monitor> create(ggml_backend_dev_t dev, int poll_ms);
+
+    virtual ~llama_vram_monitor() = default;
+
+    // the latest snapshot; cheap (a copy under a mutex), so it can be called before every batch
+    virtual llama_vram_snapshot latest() const = 0;
+
+    // where the numbers come from, for the log
+    virtual const char * source() const = 0;
+};
