+        // a probed arm learns its offset against the baseline before this step; the active arm keeps its offset, so
+        // its steps move the baseline and nothing else (a growing context then raises every arm's expected cost)
+        auto & cost = seq.cost[a];
+        if (a != seq.active && seq.base_w > 0.0) {
+            cost.w   += 1.0;
+            cost.off += dt_us - seq.base();
+        }
+
+        // the baseline is the step time without the arm's offset, so a probe of a slower arm leaves it in place
+        seq.base_w  += 1.0;
+        seq.base_us += dt_us - cost.mean();
+    }
