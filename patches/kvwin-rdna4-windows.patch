+// draft-mtp: the context-dependent draft length (--spec-draft-n-max-long / --spec-draft-long-ctx) and the sizes that
+// callers derive from it, without a model
+
+#include "common.h"
+#include "speculative.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+#define CHECK(cond) do { if (!(cond)) { fprintf(stderr, "%s:%d: CHECK(%s) failed\n", __FILE__, __LINE__, #cond); exit(1); } } while (0)
+
+int main() {
+    // off by default: the draft length is n_max everywhere, and nothing derived from it changes
+    {
+        common_params_speculative spec;
+        spec.types = { COMMON_SPECULATIVE_TYPE_DRAFT_MTP };
+        spec.draft.n_max = 4;
+        CHECK(spec.draft.n_max_long == 0);
+        CHECK(common_speculative_draft_n_max_at(spec.draft, 0) == 4);
+        CHECK(common_speculative_draft_n_max_at(spec.draft, 10000000) == 4);
+        CHECK(common_speculative_n_max(&spec) == 4);
+        CHECK(spec.need_n_rs_seq() == 4);
+    }
+
+    // n_max_long from long_ctx on
+    {
+        common_params_speculative spec;
+        spec.types = { COMMON_SPECULATIVE_TYPE_DRAFT_MTP };
+        spec.draft.n_max      = 4;
+        spec.draft.n_max_long = 7;
+        spec.draft.long_ctx   = 98304;
+        CHECK(common_speculative_draft_n_max_at(spec.draft, 0)     == 4);
+        CHECK(common_speculative_draft_n_max_at(spec.draft, 98303) == 4);
+        CHECK(common_speculative_draft_n_max_at(spec.draft, 98304) == 7);
+        CHECK(common_speculative_draft_n_max_at(spec.draft, 239000) == 7);
+        // the verify batch, the outputs and the recurrent rollback window are sized for the longer draft
+        CHECK(common_speculative_n_max(&spec) == 7);
+        CHECK(spec.need_n_rs_seq() == 7);
+    }
+
+    // a shorter long draft is allowed (n_max_long < n_max): sizes keep n_max
+    {
+        common_params_speculative spec;
+        spec.types = { COMMON_SPECULATIVE_TYPE_DRAFT_MTP };
+        spec.draft.n_max      = 6;
+        spec.draft.n_max_long = 3;
+        spec.draft.long_ctx   = 1000;
+        CHECK(common_speculative_draft_n_max_at(spec.draft, 999)  == 6);
+        CHECK(common_speculative_draft_n_max_at(spec.draft, 1000) == 3);
+        CHECK(common_speculative_n_max(&spec) == 6);
+        CHECK(spec.need_n_rs_seq() == 6);
+    }
+
+    // production: MTP + n-gram (16) with ReplaySSM: the n-gram length still dominates the sizes
+    {
+        common_params_speculative spec;
+        spec.types = { COMMON_SPECULATIVE_TYPE_DRAFT_MTP, COMMON_SPECULATIVE_TYPE_NGRAM_MOD };
+        spec.rs_replay        = true;
+        spec.draft.n_max      = 4;
+        spec.draft.n_max_long = 7;
+        spec.ngram_mod.n_max  = 16;
+        CHECK(common_speculative_n_max(&spec) == 16);
+        CHECK(spec.need_n_rs_seq() == 16);
+    }
+
+    // n_max_long is MTP-only: another draft type ignores it
+    {
+        common_params_speculative spec;
+        spec.types = { COMMON_SPECULATIVE_TYPE_DRAFT_SIMPLE };
+        spec.draft.n_max      = 4;
+        spec.draft.n_max_long = 7;
+        CHECK(common_speculative_n_max(&spec) == 4);
+    }
+
+    printf("%s: OK\n", __FILE__);
+    return 0;
+}
diff --git a/tests/test-spec-switch.cpp b/tests/test-spec-switch.cpp
new file mode 100644
index 0000000..8082949
--- /dev/null
+++ b/tests/test-spec-switch.cpp
@@ -0,0 +1,358 @@
+// --spec-switch: the drafter selection policy (common/spec-switch.h) against simulated drafters, without a model
+
+#include "../common/spec-switch.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+#define CHECK(cond) do { if (!(cond)) { fprintf(stderr, "%s:%d: CHECK(%s) failed\n", __FILE__, __LINE__, #cond); exit(1); } } while (0)
+
+// a simulated drafter: mean tokens per step (accepted + 1) and step time
+struct sim_arm {
+    double tok;
+    double ms;
+};
+
+// drives one sequence the way common_speculative_draft does: end the step in flight, choose, begin the next step
+struct sim {
+    common_spec_switch & sw;
+    int32_t s = 0;
+
+    int64_t  t_us  = 1000000;
+    int64_t  pos   = 100;
+    uint32_t rng   = 12345;
+    bool     noise = true;
+
+    double drift_ms = 0.0; // added to every arm's step time
+
+    std::vector<common_spec_switch_choice> log;
+
+    double urand() {
+        rng = rng * 1664525u + 1013904223u;
+        return (rng >> 8) / double(1u << 24);
+    }
+
+    // n steps on the arms; the number of steps each arm drafted
+    std::vector<int> run(const std::vector<sim_arm> & arms, int n, double drift_per_step = 0.0) {
+        std::vector<int> cnt(arms.size(), 0);
+        for (int i = 0; i < n; ++i) {
+            sw.step_end(s, t_us, pos);
+            const auto c = sw.choose(s);
+            sw.step_begin(s, c.arm, t_us, pos);
+            log.push_back(c);
+            cnt[c.arm]++;
+
+            const sim_arm & a = arms[c.arm];
+            int tok = (int) a.tok;
+            if (noise ? urand() < a.tok - tok : a.tok - tok >= 0.5) {
+                tok++;
+            }
+            const double ms = (a.ms + drift_ms) * (noise ? 0.95 + 0.1 * urand() : 1.0);
+            t_us += (int64_t) (ms * 1000.0);
+            pos  += tok;
+            drift_ms += drift_per_step;
+        }
+        return cnt;
+    }
+
+    // the text enters segment g; like common_speculative_draft, the step in flight ends in the old segment first
+    common_spec_switch_event segment(int32_t g) {
+        sw.step_end(s, t_us, pos);
+        return sw.segment(s, g);
+    }
+};
+
+int main() {
+    const common_spec_switch_params p;
+
+    // estimates from samples: 3 tokens per 40 ms step is 75 tok/s
+    {
+        common_spec_switch sw(p, 1);
+        CHECK(sw.rate(0, 0) == 0.0);
+        for (int i = 0; i < 20; ++i) {
+            sw.observe(0, 0, 3.0, 40000.0);
+        }
+        CHECK(std::fabs(sw.step_us(0, 0) - 40000.0) < 1.0);
+        CHECK(std::fabs(sw.rate(0, 0) - 75.0) < 0.01);
+        CHECK(sw.rate(0, 1) == 0.0); // never sampled
+    }
+
+    // a probed arm's offset: 44 ms against a 40 ms baseline, and the probe leaves the baseline in place
+    {
+        common_spec_switch sw(p, 1);
+        for (int i = 0; i < 20; ++i) {
+            sw.observe(0, 0, 3.0, 40000.0);
+        }
+        for (int i = 0; i < 4; ++i) {
+            sw.observe(0, 1, 4.0, 44000.0);
+        }
+        CHECK(std::fabs(sw.seqs[0].base() - 40000.0) < 1.0);
+        CHECK(std::fabs(sw.step_us(0, 1) - 44000.0) < 1.0);
+        CHECK(std::fabs(sw.rate(0, 1) - 4.0 / 0.044) < 0.01);
+    }
+
+    // steps that are no draft-verify cycle give no sample
+    {
+        common_spec_switch sw(p, 1);
+        const auto & arm = sw.seqs[0].segs[0][0];
+
+        sw.step_begin(0, 0, 1000000, 100);
+        sw.step_end(0, 1000000 + 3000000, 103); // longer than max_step_us
+        CHECK(arm.n_samples == 0);
+
+        sw.step_begin(0, 0, 1000000, 100);
+        sw.step_end(0, 1040000, 100); // no position advanced
+        CHECK(arm.n_samples == 0);
+
+        sw.step_begin(0, 0, 1000000, 100);
+        sw.step_end(0, 1040000, 90); // positions went back
+        CHECK(arm.n_samples == 0);
+
+        sw.step_begin(0, 0, 1000000, 100);
+        sw.step_reset(0); // a new request
+        sw.step_end(0, 1040000, 103);
+        CHECK(arm.n_samples == 0);
+
+        sw.step_begin(0, 0, 1000000, 100);
+        sw.step_end(0, 1040000, 103);
+        CHECK(arm.n_samples == 1);
+
+        // a second end without a begin is no step
+        sw.step_end(0, 1080000, 106);
+        CHECK(arm.n_samples == 1);
+
+        // a stall: far longer than this arm's steps
+        sw.step_begin(0, 0, 2000000, 200);
+        sw.step_end(0, 2000000 + 400000, 203);
+        CHECK(arm.n_samples == 1);
+    }
+
+    // pinned: always the pinned arm, no probes, segments change nothing
+    {
+        auto pp = p;
+        pp.pinned = 1;
+        common_spec_switch sw(pp, 1);
+        sim sm{sw};
+        const auto cnt = sm.run({ {3.0, 40.0}, {4.0, 40.0} }, 300);
+        CHECK(cnt[0] == 0 && cnt[1] == 300);
+        CHECK(sm.segment(3) == COMMON_SPEC_SWITCH_EVENT_NONE);
+        CHECK(sm.run({ {3.0, 40.0}, {4.0, 40.0} }, 10)[1] == 10);
+    }
+
+    // warm-up: the initial arm sets the baseline, then the other arm is probed; a clearly slower one only probe_min
+    // steps
+    {
+        auto pp = p;
+        pp.initial = 1;
+        common_spec_switch sw(pp, 1);
+        sim sm{sw};
+        sm.noise = false;
+        sm.run({ {2.0, 40.0}, {4.0, 40.0} }, 1 + pp.probe_min + 1);
+        CHECK(sm.log[0].arm == 1 && sm.log[0].event == COMMON_SPEC_SWITCH_EVENT_NONE);
+        CHECK(sm.log[1].arm == 0 && sm.log[1].event == COMMON_SPEC_SWITCH_EVENT_WARMUP);
+        for (int i = 2; i <= pp.probe_min; ++i) {
+            CHECK(sm.log[i].arm == 0 && sm.log[i].event == COMMON_SPEC_SWITCH_EVENT_NONE);
+        }
+        CHECK(sm.log[pp.probe_min + 1].arm == 1);
+        CHECK(sw.seqs[0].segs[0][0].n_probes == 1);
+    }
+
+    // a probe of an arm within noise of the active one goes on to probe_max, and an even race does not switch
+    {
+        common_spec_switch sw(p, 1);
+        sim sm{sw};
+        sm.noise = false;
+        sm.run({ {3.0, 40.0}, {3.0, 40.0} }, 1 + p.probe_max + 1);
+        for (int i = 1; i <= p.probe_max; ++i) {
+            CHECK(sm.log[i].arm == 1);
+        }
+        CHECK(sm.log[p.probe_max + 1].arm == 0);
+        CHECK(sw.seqs[0].n_switches == 0);
+    }
+
+    // the faster arm by tokens per second wins: 4 tokens / 44 ms (91 tok/s) over 3 tokens / 40 ms (75 tok/s)
+    {
+        common_spec_switch sw(p, 1);
+        sim sm{sw};
+        const std::vector<sim_arm> arms = { {3.0, 40.0}, {4.0, 44.0} };
+        sm.run(arms, 300);
+        CHECK(sw.seqs[0].active == 1);
+        const auto cnt = sm.run(arms, 500);
+        CHECK(cnt[1] >= 470);
+    }
+
+    // throughput, not acceptance: more tokens per step, but slower steps (3.6 / 52 ms = 69 tok/s vs 75)
+    {
+        common_spec_switch sw(p, 1);
+        sim sm{sw};
+        const auto cnt = sm.run({ {3.0, 40.0}, {3.6, 52.0} }, 600);
+        CHECK(sw.seqs[0].active == 0);
+        CHECK(sw.seqs[0].n_switches == 0);
+        CHECK(cnt[0] >= 550);
+    }
+
+    // hysteresis: 2.6% faster is no reason to switch, 15% is (once)
+    {
+        common_spec_switch sw(p, 1);
+        sim sm{sw};
+        sm.noise = false;
+        sm.run({ {3.0, 40.0}, {3.0, 39.0} }, 400);
+        CHECK(sw.seqs[0].n_switches == 0);
+        CHECK(sw.seqs[0].active == 0);
+    }
+    {
+        common_spec_switch sw(p, 1);
+        sim sm{sw};
+        sm.noise = false;
+        sm.run({ {3.0, 40.0}, {3.0, 35.0} }, 600);
+        CHECK(sw.seqs[0].n_switches == 1);
+        CHECK(sw.seqs[0].active == 1);
+    }
+
+    // backoff: probes thin out while they keep confirming the active arm
+    {
+        common_spec_switch sw(p, 1);
+        sim sm{sw};
+        const auto cnt = sm.run({ {3.5, 40.0}, {2.0, 44.0} }, 4000);
+        CHECK(sw.seqs[0].n_switches == 0);
+        CHECK(sw.seqs[0].backoff == p.backoff_max);
+        CHECK(sw.seqs[0].segs[0][1].n_probes <= 4000 / (sw.probe_interval() * p.backoff_max) + 5);
+        CHECK(cnt[1] < 0.03 * 4000);
+    }
+
+    // the text changes within a segment (prose -> code): the active arm's drop resets the backoff and the next probe
+    // switches; two switches are always at least `dwell` steps apart
+    {
+        common_spec_switch sw(p, 1);
+        sim sm{sw};
+        sm.run({ {3.5, 40.0}, {2.5, 43.0} }, 1500);
+        CHECK(sw.seqs[0].active == 0);
+        CHECK(sw.seqs[0].backoff > 1);
+
+        const std::vector<sim_arm> phase2 = { {2.4, 40.0}, {4.0, 43.0} };
+        const size_t i_change = sm.log.size();
+        sm.run(phase2, sw.probe_interval() + p.probe_max + 30);
+        CHECK(sw.seqs[0].active == 1);
+        const auto cnt = sm.run(phase2, 400);
+        CHECK(cnt[1] >= 370);
+
+        int last_switch = -1;
+        int n_since     = 0;
+        for (size_t i = i_change; i < sm.log.size(); ++i) {
+            if (sm.log[i].event == COMMON_SPEC_SWITCH_EVENT_SWITCH) {
+                CHECK(last_switch < 0 || n_since >= p.dwell);
+                last_switch = (int) i;
+                n_since     = 0;
+            }
+            n_since++;
+        }
+        CHECK(last_switch >= 0);
+    }
+
+    // segments keep their own estimates: entering one drafts with its faster arm at once (thinking, then the answer)
+    {
+        common_spec_switch sw(p, 1);
+        sim sm{sw};
+        const std::vector<sim_arm> think  = { {3.0, 40.0}, {5.0, 43.0} };
+        const std::vector<sim_arm> answer = { {3.0, 40.0}, {2.4, 43.0} };
+
+        CHECK(sm.segment(1) == COMMON_SPEC_SWITCH_EVENT_NONE);
+        sm.run(think, 200);
+        CHECK(sw.seqs[0].active == 1);
+
+        // no estimate of the answer yet: the active arm goes on and the other one gets its warm-up
+        CHECK(sm.segment(2) == COMMON_SPEC_SWITCH_EVENT_NONE);
+        CHECK(sw.seqs[0].active == 1);
+        sm.run(answer, 200);
+        CHECK(sw.seqs[0].active == 0);
+
+        CHECK(sm.segment(1) == COMMON_SPEC_SWITCH_EVENT_SWITCH);
+        CHECK(sw.seqs[0].active == 1);
+        CHECK(sm.run(think, 1)[1] == 1);
+
+        CHECK(sm.segment(2) == COMMON_SPEC_SWITCH_EVENT_SWITCH);
+        CHECK(sw.seqs[0].active == 0);
+        CHECK(sm.run(answer, 1)[0] == 1);
+
+        CHECK(sm.segment(99) == COMMON_SPEC_SWITCH_EVENT_NONE);
+        CHECK(sw.seqs[0].seg == p.n_segs - 1);
+    }
+
+    // explore 0: only the warm-up probe; a drop of the active arm far below the other's estimate still switches
+    {
+        auto pp = p;
+        pp.explore = 0.0f;
+        common_spec_switch sw(pp, 1);
+        sim sm{sw};
+        auto cnt = sm.run({ {3.5, 40.0}, {3.0, 42.0} }, 1000);
+        CHECK(cnt[1] >= pp.probe_min && cnt[1] <= pp.probe_max);
+        CHECK(sw.seqs[0].active == 0);
+
+        cnt = sm.run({ {1.5, 40.0}, {3.0, 42.0} }, 100);
+        CHECK(sw.seqs[0].active == 1);
+    }
+
+    // a growing context raises every step: the idle arm's stale estimate grows with the baseline. Arm 1 needs 33 ms
+    // more per step; at 40 ms its 4th token is not worth that (55 vs 75 tok/s), at 100 ms they are even (30 vs 30
+    // tok/s). Without the baseline its 73 ms estimate from the start would look like 55 tok/s against 30 and switch.
+    {
+        auto pp = p;
+        pp.explore = 0.0f;
+        common_spec_switch sw(pp, 1);
+        sim sm{sw};
+        sm.noise = false;
+        sm.run({ {3.0, 40.0}, {4.0, 73.0} }, 50);
+        sm.run({ {3.0, 40.0}, {4.0, 73.0} }, 600, 0.1); // +60 ms over the run
+        CHECK(sw.seqs[0].n_switches == 0);
+        CHECK(std::fabs(sw.step_us(0, 1) - (sw.step_us(0, 0) + 33000.0)) < 500.0);
+    }
+
+    // sequences are independent
+    {
+        common_spec_switch sw(p, 2);
+        sim s0{sw};
+        sim s1{sw};
+        s1.s = 1;
+        s0.run({ {3.0, 40.0}, {4.0, 40.0} }, 200);
+        s1.run({ {4.0, 40.0}, {3.0, 40.0} }, 200);
+        CHECK(sw.seqs[0].active == 1);
+        CHECK(sw.seqs[1].active == 0);
+    }
+
+    // one arm: no probes, no switches
+    {
+        auto pp = p;
+        pp.n_arms = 1;
+        common_spec_switch sw(pp, 1);
+        sim sm{sw};
+        const auto cnt = sm.run({ {3.0, 40.0} }, 200);
+        CHECK(cnt[0] == 200);
+    }
+
+    // out-of-range parameters are clamped
+    {
+        auto pp = p;
+        pp.initial   = 5;
+        pp.pinned    = 7;
+        pp.explore   = 3.0f;
+        pp.probe_min = 0;
+        pp.probe_max = -2;
+        pp.decay     = 1.5f;
+        pp.n_segs    = 0;
+        common_spec_switch sw(pp, 1);
+        CHECK(sw.params.initial == 0);
+        CHECK(sw.params.pinned == -1);
+        CHECK(sw.params.explore == 0.5f);
+        CHECK(sw.params.probe_min == 1);
+        CHECK(sw.params.probe_max == 1);
+        CHECK(sw.params.decay == 0.98f);
+        CHECK(sw.params.n_segs == 1);
+        CHECK(sw.probe_interval() == 1);
+    }
+
+    printf("OK\n");
+    return 0;
+}
