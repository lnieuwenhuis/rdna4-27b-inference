diff --git a/common/spec-switch.h b/common/spec-switch.h
new file mode 100644
index 0000000..b331a87
--- /dev/null
+++ b/common/spec-switch.h
@@ -0,0 +1,469 @@
+#pragma once
+
+// --spec-switch: pick one of several model drafters (draft-mtp and draft-dflash) for each draft.
+//
+// Every drafter runs process() and accept() on every target batch, so any of them can draft any single step. A step
+// runs from one draft call of a sequence to its next one. Its tokens are the positions the sequence advanced (the
+// accepted draft plus the target's own token, whichever way the server got there, replays included) and its cost is
+// the wall time, which holds the draft, the verify and everything around them.
+//
+// Per sequence the policy keeps discounted means of each drafter's tokens per step and of its step time, and drafts
+// with the one that has the higher expected tokens per second:
+// - The step time is a baseline shared by all drafters plus a per-drafter offset. The active drafter's offset stays
+//   fixed, so the baseline follows its steps; another drafter learns its offset against the baseline while it is
+//   probed. A context that grows while a drafter sits idle so raises that drafter's stale estimate too.
+// - Tokens per step depend on the text, so they are kept per segment: the stretch of text after an added token such
+//   as <think>, </think> or <tool_call> (the caller maps those tokens to segments). Entering a segment picks the
+//   drafter that was faster there before, so thinking and the answer after it each get theirs without a probe.
+// - A probe drafts with the other drafter for at least probe_min steps and goes on, up to probe_max, while the two
+//   estimates are within noise of each other. It switches only when the other drafter is faster by more than the
+//   hysteresis plus z standard errors (half of them once the probe ran out). Probes come about every
+//   probe_min / explore steps; each probe that confirms the active drafter doubles that interval (up to backoff_max
+//   times); a switch, a new segment or the active drafter's tokens per step moving by drift_reset since that probe
+//   (the text changed) resets it.
+//
+// No llama.h dependency: the policy is tested on its own (tests/test-spec-switch.cpp).
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+struct common_spec_switch_params {
+    int32_t n_arms = 2;
+    int32_t n_segs = 16; // segment 0 is the fallback for text without a known added token
+
+    int32_t initial = 0;  // the arm a sequence starts on
+    int32_t pinned  = -1; // >= 0: always this arm (the other drafters still keep their state current)
+
+    float   explore     = 0.08f; // probes take about this share of the steps, before the backoff
+    int32_t probe_min   = 4;     // steps per probe at least; an arm's first probe in a segment is its warm-up
+    int32_t probe_max   = 16;    // steps per probe at most, while the comparison is still open
+    int32_t backoff_max = 8;     // the probe interval grows up to this factor while probes confirm the active arm
+    float   drift_reset = 0.25f; // the active arm's tokens per step moving this far from the last probe's resets it
+
+    float   z          = 1.5f;  // standard errors by which a probe must beat the active arm (or lose, to end early)
+    float   hysteresis = 0.05f; // and by this fraction
+    int32_t dwell      = 8;     // steps on a newly chosen arm before the next switch outside a probe
+    float   decay      = 0.98f; // weight of a sample after each further step (memory of about 1/(1 - decay) steps)
+
+    // a step outside these bounds is not one draft-verify cycle (an idle gap, a stall, a context shift): no sample
+    int64_t max_step_us     = 2000000;
+    int32_t max_step_tokens = 64;
+    float   max_step_rel    = 4.0f; // step time over the arm's expected step time
+};
+
+enum common_spec_switch_event {
+    COMMON_SPEC_SWITCH_EVENT_NONE,   // the arm keeps drafting, or a probe continues
+    COMMON_SPEC_SWITCH_EVENT_SWITCH, // the returned arm becomes the active one
+    COMMON_SPEC_SWITCH_EVENT_WARMUP, // the first probe of the returned arm in this segment starts
+    COMMON_SPEC_SWITCH_EVENT_PROBE,  // a probe of the returned arm starts
+};
+
+struct common_spec_switch_choice {
+    int32_t                  arm;
+    common_spec_switch_event event;
+};
+
+// tokens per step of one arm in one segment, as discounted sums
+struct common_spec_switch_arm {
+    double w    = 0.0;
+    double tok  = 0.0;
+    double tok2 = 0.0;
+
+    int64_t n_chosen  = 0; // steps this arm was chosen for
+    int64_t n_samples = 0; // of them, steps that gave a sample
+    int64_t n_probes  = 0;
+
+    bool valid() const {
+        return w > 0.0;
+    }
+
+    double tok_mean() const {
+        return tok / w;
+    }
+
+    double tok_var() const {
+        const double m = tok_mean();
+        return std::max(0.0, tok2 / w - m * m);
+    }
+};
+
+// an arm's step time over the baseline, from the steps it drafted while another arm was active
+struct common_spec_switch_cost {
+    double w   = 0.0;
+    double off = 0.0; // us
+
+    // 0 until the arm was probed: the first active arm defines the baseline
+    double mean() const {
+        return w > 0.0 ? off / w : 0.0;
+    }
+};
+
+struct common_spec_switch_seq {
+    std::vector<std::vector<common_spec_switch_arm>> segs; // [n_segs][n_arms]
+    std::vector<common_spec_switch_cost>             cost; // [n_arms]
+
+    int32_t seg = 0;
+
+    // discounted step time with each sample's arm offset taken out: what any arm costs now, before its offset
+    double base_w  = 0.0;
+    double base_us = 0.0;
+
+    int32_t active        = 0;
+    int32_t probe_arm     = -1; // >= 0: a probe of this arm is running
+    int32_t probe_done    = 0;  // steps the running probe has taken
+    int32_t n_on_active   = 0;  // steps on the active arm since it became active
+    int32_t n_since_probe = 0;  // steps on the active arm since the last probe started
+    int32_t backoff       = 1;  // the probe interval's current factor
+    double  backoff_tok   = 0;  // the active arm's tokens per step when the backoff last grew
+    int64_t n_switches    = 0;
+
+    // the step in flight
+    int32_t step_arm  = -1;
+    int64_t step_t_us = 0;
+    int64_t step_pos  = 0;
+
+    std::vector<common_spec_switch_arm> & arms() {
+        return segs[seg];
+    }
+
+    const std::vector<common_spec_switch_arm> & arms() const {
+        return segs[seg];
+    }
+
+    double base() const {
+        return base_w > 0.0 ? base_us / base_w : 0.0;
+    }
+};
+
+struct common_spec_switch {
+    common_spec_switch_params params;
+
+    std::vector<common_spec_switch_seq> seqs;
+
+    common_spec_switch(const common_spec_switch_params & p, uint32_t n_seq) : params(p) {
+        params.n_arms = std::max(1, params.n_arms);
+        params.n_segs = std::max(1, params.n_segs);
+        if (params.initial < 0 || params.initial >= params.n_arms) {
+            params.initial = 0;
+        }
+        if (params.pinned >= params.n_arms) {
+            params.pinned = -1;
+        }
+        params.probe_min   = std::max(1, params.probe_min);
+        params.probe_max   = std::max(params.probe_min, params.probe_max);
+        params.backoff_max = std::max(1, params.backoff_max);
+        // NaN fails these tests too
+        if (!(params.explore > 0.0f)) {
+            params.explore = 0.0f;
+        }
+        params.explore = std::min(params.explore, 0.5f);
+        if (!(params.decay > 0.0f && params.decay < 1.0f)) {
+            params.decay = 0.98f;
+        }
+        if (!(params.z >= 0.0f)) {
+            params.z = 0.0f;
+        }
+        if (!(params.hysteresis >= 0.0f)) {
+            params.hysteresis = 0.0f;
+        }
+        if (!(params.drift_reset >= 0.0f)) {
+            params.drift_reset = 0.25f;
+        }
+
+        seqs.resize(n_seq);
+        for (auto & s : seqs) {
+            s.segs.assign(params.n_segs, std::vector<common_spec_switch_arm>(params.n_arms));
+            s.cost.assign(params.n_arms, {});
+            s.active = params.pinned >= 0 ? params.pinned : params.initial;
+        }
+    }
+
+    // active steps between two probes before the backoff, so that probes of probe_min steps take the explore share
+    int32_t probe_interval() const {
+        if (params.explore <= 0.0f) {
+            return -1;
+        }
+        const double n = params.probe_min * (1.0 - params.explore) / params.explore;
+        return (int32_t) std::min(1e6, std::max(1.0, std::round(n)));
+    }
+
+    // expected step time of arm a in sequence s, in us (0: no estimate)
+    double step_us(int32_t s, int32_t a) const {
+        const auto & seq = seqs[s];
+        if (!seq.arms()[a].valid() || seq.base_w <= 0.0) {
+            return 0.0;
+        }
+        return std::max(1.0, seq.base() + seq.cost[a].mean());
+    }
+
+    // expected tokens per second of arm a in sequence s, in its current segment (0: no estimate)
+    double rate(int32_t s, int32_t a) const {
+        const double t_us = step_us(s, a);
+        if (t_us <= 0.0) {
+            return 0.0;
+        }
+        return 1e6 * seqs[s].arms()[a].tok_mean() / t_us;
+    }
+
+    // relative standard error of arm a's tokens per step; a faded estimate counts as most of a probe
+    double tok_se_rel(int32_t s, int32_t a) const {
+        const auto & arm = seqs[s].arms()[a];
+        const double n   = std::max(arm.w, 0.8 * params.probe_min);
+        const double var = std::max(arm.tok_var(), 0.5); // a few equal samples are no proof of no variance
+        return std::sqrt(var / n) / arm.tok_mean();
+    }
+
+    // false if either arm has no estimate; else d = log(rate(b) / rate(a)) and its standard error
+    bool compare(int32_t s, int32_t a, int32_t b, double & d, double & se) const {
+        const double ra = rate(s, a);
+        const double rb = rate(s, b);
+        if (ra <= 0.0 || rb <= 0.0) {
+            return false;
+        }
+        d  = std::log(rb / ra);
+        se = std::sqrt(tok_se_rel(s, a) * tok_se_rel(s, a) + tok_se_rel(s, b) * tok_se_rel(s, b));
+        return true;
+    }
+
+    // the text of sequence s enters segment g: the arm that was faster there drafts (SWITCH if that changes the arm)
+    common_spec_switch_event segment(int32_t s, int32_t g) {
+        auto & seq = seqs[s];
+        g = std::min(std::max(g, 0), params.n_segs - 1);
+        if (g == seq.seg) {
+            return COMMON_SPEC_SWITCH_EVENT_NONE;
+        }
+
+        // its estimates decide now, the next probe comes a full interval later
+        seq.seg           = g;
+        seq.backoff       = 1;
+        seq.probe_arm     = -1;
+        seq.probe_done    = 0;
+        seq.n_since_probe = 0;
+
+        if (params.pinned >= 0) {
+            return COMMON_SPEC_SWITCH_EVENT_NONE;
+        }
+
+        // only with an estimate of every arm here; else the active arm drafts and the others get their warm-up
+        int32_t best   = -1;
+        double  r_best = 0.0;
+        for (int32_t a = 0; a < params.n_arms; ++a) {
+            const double r = rate(s, a);
+            if (r <= 0.0) {
+                return COMMON_SPEC_SWITCH_EVENT_NONE;
+            }
+            if (r > r_best) {
+                best   = a;
+                r_best = r;
+            }
+        }
+
+        if (best != seq.active) {
+            switch_to(seq, best);
+            return COMMON_SPEC_SWITCH_EVENT_SWITCH;
+        }
+        return COMMON_SPEC_SWITCH_EVENT_NONE;
+    }
+
+    // the arm to draft with in this step; call once per step in which the switch decides
+    common_spec_switch_choice choose(int32_t s) {
+        auto & seq  = seqs[s];
+        auto & arms = seq.arms();
+
+        if (params.pinned >= 0) {
+            arms[params.pinned].n_chosen++;
+            return { params.pinned, COMMON_SPEC_SWITCH_EVENT_NONE };
+        }
+
+        const double lh = std::log(1.0 + params.hysteresis);
+
+        common_spec_switch_event event = COMMON_SPEC_SWITCH_EVENT_NONE;
+
+        // a running probe goes on while the comparison is open
+        if (seq.probe_arm >= 0) {
+            const int32_t b = seq.probe_arm;
+
+            bool do_switch = false;
+            bool do_end    = seq.probe_done >= params.probe_max;
+            if (seq.probe_done >= params.probe_min) {
+                double d  = 0.0;
+                double se = 0.0;
+                if (compare(s, seq.active, b, d, se)) {
+                    // a probe that ran out still needs half the margin: a coin flip near the hysteresis is no reason
+                    do_switch = d > lh + params.z * se || (do_end && d > lh + 0.5 * params.z * se);
+                    do_end    = do_end || d < -params.z * se;
+                }
+            }
+
+            if (do_switch) {
+                switch_to(seq, b);
+                event = COMMON_SPEC_SWITCH_EVENT_SWITCH;
+            } else if (do_end) {
+                seq.probe_arm  = -1;
+                seq.probe_done = 0;
+                seq.backoff    = std::min(2 * seq.backoff, params.backoff_max);
+                if (arms[seq.active].valid()) {
+                    seq.backoff_tok = arms[seq.active].tok_mean();
+                }
+            } else {
+                seq.probe_done++;
+                arms[b].n_chosen++;
+                return { b, COMMON_SPEC_SWITCH_EVENT_NONE };
+            }
+        }
+
+        // probes compare against the active arm, so it needs an estimate in this segment first
+        const bool can_probe = params.n_arms > 1 && seq.base_w > 0.0 && arms[seq.active].valid();
+
+        // warm-up: each arm is tried once per segment before the estimates decide
+        for (int32_t a = 0; event == COMMON_SPEC_SWITCH_EVENT_NONE && can_probe && a < params.n_arms; ++a) {
+            if (a != seq.active && arms[a].n_chosen == 0) {
+                return probe(seq, a, COMMON_SPEC_SWITCH_EVENT_WARMUP);
+            }
+        }
+
+        // outside probes, a clear lead of an older estimate (the active arm got slower) switches too
+        if (event == COMMON_SPEC_SWITCH_EVENT_NONE && seq.n_on_active >= params.dwell) {
+            int32_t best   = -1;
+            double  d_best = 0.0;
+            for (int32_t a = 0; a < params.n_arms; ++a) {
+                double d  = 0.0;
+                double se = 0.0;
+                if (a != seq.active && compare(s, seq.active, a, d, se) && d > lh + params.z * se && d > d_best) {
+                    best   = a;
+                    d_best = d;
+                }
+            }
+            if (best >= 0) {
+                switch_to(seq, best);
+                event = COMMON_SPEC_SWITCH_EVENT_SWITCH;
+            }
+        }
+
+        // the text changed since the last probe confirmed the active arm: probe at the normal interval again
+        if (seq.backoff > 1 && arms[seq.active].valid() && seq.backoff_tok > 0.0 &&
+                std::fabs(std::log(arms[seq.active].tok_mean() / seq.backoff_tok)) > std::log(1.0 + params.drift_reset)) {
+            seq.backoff = 1;
+        }
+
+        const int32_t interval = probe_interval();
+        if (event == COMMON_SPEC_SWITCH_EVENT_NONE && can_probe && interval > 0 &&
+                seq.n_since_probe >= (int64_t) interval * seq.backoff) {
+            // the arm whose estimate is the most faded
+            int32_t stale = -1;
+            for (int32_t a = 0; a < params.n_arms; ++a) {
+                if (a != seq.active && (stale < 0 || arms[a].w < arms[stale].w)) {
+                    stale = a;
+                }
+            }
+            return probe(seq, stale, COMMON_SPEC_SWITCH_EVENT_PROBE);
+        }
+
+        seq.n_on_active++;
+        seq.n_since_probe++;
+        arms[seq.active].n_chosen++;
+
+        return { seq.active, event };
+    }
+
+    // a step of sequence s with arm a starts at t_us with the next token at position pos
+    void step_begin(int32_t s, int32_t a, int64_t t_us, int64_t pos) {
+        auto & seq = seqs[s];
+        seq.step_arm  = a;
+        seq.step_t_us = t_us;
+        seq.step_pos  = pos;
+    }
+
+    // the next draft call of sequence s starts at t_us with the next token at position pos: the step in flight ends
+    // (call it before segment(), the step belongs to the segment it was drafted in)
+    void step_end(int32_t s, int64_t t_us, int64_t pos) {
+        auto & seq = seqs[s];
+        const int32_t a = seq.step_arm;
+        if (a < 0) {
+            return;
+        }
+        seq.step_arm = -1;
+
+        const int64_t dt    = t_us - seq.step_t_us;
+        const int64_t n_tok = pos  - seq.step_pos;
+        if (dt <= 0 || dt > params.max_step_us || n_tok < 1 || n_tok > params.max_step_tokens) {
+            return;
+        }
+        const double t_exp = step_us(s, a);
+        if (t_exp > 0.0 && dt > params.max_step_rel * t_exp) {
+            return;
+        }
+
+        observe(s, a, (double) n_tok, (double) dt);
+    }
+
+    // drop the step in flight: a new request or a restored state, the next draft call does not end it
+    void step_reset(int32_t s) {
+        seqs[s].step_arm = -1;
+    }
+
+    void observe(int32_t s, int32_t a, double n_tok, double dt_us) {
+        auto & seq  = seqs[s];
+        auto & arms = seq.arms();
+
+        // an estimate stops fading at a tiny weight: its mean stays, and the next sample replaces it (a sequence lives
+        // across requests, and an arm unused for tens of thousands of steps would underflow to no estimate at all)
+        const double g     = params.decay;
+        const double w_min = 1e-6;
+        seq.base_w  *= g;
+        seq.base_us *= g;
+        for (auto & x : arms) {
+            if (x.w > w_min) {
+                x.w    *= g;
+                x.tok  *= g;
+                x.tok2 *= g;
+            }
+        }
+        for (auto & c : seq.cost) {
+            if (c.w > w_min) {
+                c.w   *= g;
+                c.off *= g;
+            }
+        }
