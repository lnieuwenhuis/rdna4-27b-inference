diff --git a/tests/test-checkpoint-buffers.cpp b/tests/test-checkpoint-buffers.cpp
new file mode 100644
index 0000000..2985503
--- /dev/null
+++ b/tests/test-checkpoint-buffers.cpp
@@ -0,0 +1,72 @@
+// --ctx-checkpoints-reuse: the spare buffers of erased context checkpoints (common_checkpoint_buffers)
+
+#include "common.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+#define CHECK(cond) do { if (!(cond)) { fprintf(stderr, "%s:%d: CHECK(%s) failed\n", __FILE__, __LINE__, #cond); exit(1); } } while (0)
+
+static std::vector<uint8_t> buf(size_t size, uint8_t fill) {
+    return std::vector<uint8_t>(size, fill);
+}
+
+int main() {
+    // empty: take gives an empty buffer
+    {
+        common_checkpoint_buffers spare;
+        CHECK(spare.size() == 0 && spare.bytes() == 0);
+        CHECK(spare.take().capacity() == 0);
+    }
+
+    // keeps the n_max largest, hands out the largest first
+    {
+        common_checkpoint_buffers spare;
+        spare.put(buf(100, 1));
+        spare.put(buf(300, 3));
+        spare.put(buf(200, 2));
+        CHECK(spare.size() == 2);
+        CHECK(spare.bytes() >= 500 && spare.bytes() < 600); // 300 + 200, the 100 one was freed
+
+        std::vector<uint8_t> a = spare.take();
+        CHECK(a.capacity() >= 300 && a.size() == 300 && a[0] == 3);
+        std::vector<uint8_t> b = spare.take();
+        CHECK(b.capacity() >= 200 && b.size() == 200 && b[0] == 2);
+        CHECK(spare.size() == 0 && spare.take().capacity() == 0);
+    }
+
+    // a buffer without capacity is dropped; a smaller one does not displace larger ones
+    {
+        common_checkpoint_buffers spare;
+        spare.put(std::vector<uint8_t>());
+        CHECK(spare.size() == 0);
+        spare.put(buf(500, 5));
+        spare.put(buf(400, 4));
+        spare.put(buf(10, 9));
+        CHECK(spare.size() == 2);
+        CHECK(spare.take()[0] == 5);
+        CHECK(spare.take()[0] == 4);
+    }
+
+    // n_max 0 keeps nothing
+    {
+        common_checkpoint_buffers spare;
+        spare.n_max = 0;
+        spare.put(buf(100, 1));
+        CHECK(spare.size() == 0);
+    }
+
+    // the memory moves, it is not copied: the data pointer survives put/take
+    {
+        common_checkpoint_buffers spare;
+        std::vector<uint8_t> v = buf(1 << 20, 7);
+        const uint8_t * p = v.data();
+        spare.put(std::move(v));
+        std::vector<uint8_t> w = spare.take();
+        CHECK(w.data() == p);
+    }
+
+    printf("%s: OK\n", __FILE__);
+    return 0;
+}
diff --git a/tests/test-kv-pool-ctl.cpp b/tests/test-kv-pool-ctl.cpp
new file mode 100644
index 0000000..b47e1dc
--- /dev/null
+++ b/tests/test-kv-pool-ctl.cpp
@@ -0,0 +1,252 @@
+// the adaptive KV stream pool policy (src/llama-kv-pool-ctl.h), without a GPU
+
+#include "../src/llama-kv-pool-ctl.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+static constexpr size_t  MiB = 1024*1024;
+static constexpr int64_t SEC = 1000000;
+
+#define CHECK(cond) do { if (!(cond)) { fprintf(stderr, "%s:%d: CHECK(%s) failed\n", __FILE__, __LINE__, #cond); exit(1); } } while (0)
+
+static llama_kv_pool_policy policy() {
+    llama_kv_pool_policy p;
+    p.min_size = 256*MiB;
+    p.max_size = 2048*MiB;
+    return p;
+}
+
+// a process with `free_mib` of local memory left in its budget and on the adapter
+static llama_vram_snapshot snap(int64_t t_us, int64_t free_mib, uint64_t usage_mib = 12000, uint64_t nonlocal_mib = 7000) {
+    llama_vram_snapshot s;
+    s.valid            = true;
+    s.t_us             = t_us;
+    s.usage            = usage_mib*MiB;
+    s.budget           = s.usage + (uint64_t) (free_mib*(int64_t) MiB);
+    s.usage_nonlocal   = nonlocal_mib*MiB;
+    s.adapter_total    = 16000*MiB;
+    s.adapter_resident = s.adapter_total - (uint64_t) (free_mib*(int64_t) MiB);
+    return s;
+}
+
+static void test_invalid_keeps() {
+    llama_kv_pool_ctl ctl(policy());
+    CHECK(ctl.decide(llama_vram_snapshot(), 256*MiB, SEC).why == llama_kv_pool_ctl::KEEP);
+}
+
+static void test_grows_in_steps_after_delay() {
+    llama_kv_pool_ctl ctl(policy());
+    size_t cur = 256*MiB;
+    int64_t t = SEC;
+    // plenty of room: nothing before grow_delay, then one step
+    CHECK(ctl.decide(snap(t, 3000), cur, t).why == llama_kv_pool_ctl::KEEP);
+    t += 4*SEC;
+    CHECK(ctl.decide(snap(t, 3000), cur, t).why == llama_kv_pool_ctl::KEEP);
+    t += 1*SEC;
+    auto d = ctl.decide(snap(t, 3000), cur, t);
+    CHECK(d.why == llama_kv_pool_ctl::GROW && d.size == 512*MiB);
+    ctl.on_resized(t, cur, d.size);
+    cur = d.size;
+    // the next step waits another grow_delay
+    t += SEC;
+    CHECK(ctl.decide(snap(t, 2750), cur, t).why == llama_kv_pool_ctl::KEEP);
+    // up to max_size and no further
+    for (int i = 0; i < 100 && cur < 2048*MiB; ++i) {
+        t += 6*SEC;
+        d = ctl.decide(snap(t, 3000), cur, t);
+        if (d.size) {
+            ctl.on_resized(t, cur, d.size);
+            cur = d.size;
+        }
+    }
+    CHECK(cur == 2048*MiB);
+    t += 60*SEC;
+    CHECK(ctl.decide(snap(t, 3000), cur, t).size == 0);
+}
+
+static void test_grow_leaves_hysteresis() {
+    llama_kv_pool_ctl ctl(policy());
+    int64_t t = SEC;
+    // 512 margin + 256 hysteresis + 100: a grow may only take what keeps margin + hysteresis/2 free
+    ctl.decide(snap(t, 868), 256*MiB, t);
+    t += 5*SEC;
+    auto d = ctl.decide(snap(t, 868), 256*MiB, t);
+    CHECK(d.why == llama_kv_pool_ctl::GROW && d.size == (256 + 868 - 512 - 128)*MiB);
+}
+
+static void test_no_grow_while_held_back() {
+    llama_kv_pool_ctl ctl(policy());
+    int64_t t = SEC;
+    for (; t < 60*SEC; t += SEC) {
+        CHECK(ctl.decide(snap(t, 3000), 256*MiB, t, /*allow_grow =*/ false).size == 0);
+    }
+    // the headroom held all along: the first idle tick grows at once
+    CHECK(ctl.decide(snap(t, 3000), 256*MiB, t, true).why == llama_kv_pool_ctl::GROW);
+}
+
+static void test_hysteresis_band_keeps() {
+    llama_kv_pool_ctl ctl(policy());
+    for (int64_t t = SEC; t < 120*SEC; t += SEC) {
+        CHECK(ctl.decide(snap(t, 700), 1024*MiB, t).size == 0); // between margin and margin + hysteresis
+    }
+}
+
+static void test_shrinks_at_once() {
+    llama_kv_pool_ctl ctl(policy());
+    // monitors on: 1.8 GiB less free memory, 300 MiB left
+    auto d = ctl.decide(snap(SEC, 300), 2048*MiB, SEC);
+    CHECK(d.why == llama_kv_pool_ctl::SHRINK_BUDGET);
+    CHECK(d.size == (2048 - (512 - 300) - 128)*MiB);
+    // never below min_size
+    llama_kv_pool_ctl ctl2(policy());
+    d = ctl2.decide(snap(SEC, -1500), 1024*MiB, SEC);
+    CHECK(d.why == llama_kv_pool_ctl::SHRINK_BUDGET && d.size == 256*MiB);
+    d = ctl2.decide(snap(2*SEC, -1500), 256*MiB, 2*SEC);
+    CHECK(d.why == llama_kv_pool_ctl::AT_MIN && d.size == 0);
+}
+
+static void test_shrink_accounts_for_slots() {
+    // the streaming slots grow back by 1/8 of what the pool gives up
+    llama_kv_pool_policy p = policy();
+    p.net_fraction = 0.875;
+    llama_kv_pool_ctl ctl(p);
+    auto d = ctl.decide(snap(SEC, 300), 2048*MiB, SEC);
+    CHECK(d.why == llama_kv_pool_ctl::SHRINK_BUDGET);
+    CHECK(d.size == 2048*MiB - (size_t) ((double) (340*MiB)/0.875));
+}
+
+static void test_cooldown_after_shrink() {
+    llama_kv_pool_ctl ctl(policy());
+    int64_t t = SEC;
+    auto d = ctl.decide(snap(t, 100), 1024*MiB, t);
+    CHECK(d.size == (1024 - 540)*MiB);
+    ctl.on_resized(t, 1024*MiB, d.size);
+    size_t cur = d.size;
+    // room again right away: no grow during the cooldown
+    for (t += SEC; t < 31*SEC; t += SEC) {
+        CHECK(ctl.decide(snap(t, 3000), cur, t).size == 0);
+    }
+    t += 5*SEC;
+    CHECK(ctl.decide(snap(t, 3000), cur, t).why == llama_kv_pool_ctl::GROW);
+}
+
+static void test_flapping_doubles_cooldown_once_and_resets() {
+    llama_kv_pool_ctl ctl(policy());
+    int64_t t = SEC;
+    ctl.decide(snap(t, 3000), 512*MiB, t);
+    t += 5*SEC;
+    auto d = ctl.decide(snap(t, 3000), 512*MiB, t);
+    CHECK(d.why == llama_kv_pool_ctl::GROW && d.size == 768*MiB);
+    ctl.on_resized(t, 512*MiB, 768*MiB);
+    // the budget drops 10 s later: two shrinks for one event double the cooldown once
+    t += 10*SEC;
+    d = ctl.decide(snap(t, 200), 768*MiB, t);
+    CHECK(d.why == llama_kv_pool_ctl::SHRINK_BUDGET && d.size == 328*MiB);
+    ctl.on_resized(t, 768*MiB, 328*MiB);
+    CHECK(ctl.cooldown_cur() == 60*SEC);
+    t += SEC;
+    d = ctl.decide(snap(t, 200), 328*MiB, t);
+    CHECK(d.why == llama_kv_pool_ctl::SHRINK_BUDGET && d.size == 256*MiB);
+    ctl.on_resized(t, 328*MiB, 256*MiB);
+    CHECK(ctl.cooldown_cur() == 60*SEC);
+    // a grow long after the last shrink resets it
+    t += 601*SEC;
+    CHECK(ctl.decide(snap(t, 3000), 256*MiB, t).size == 0);
+    t += 5*SEC;
+    d = ctl.decide(snap(t, 3000), 256*MiB, t);
+    CHECK(d.why == llama_kv_pool_ctl::GROW);
+    ctl.on_resized(t, 256*MiB, d.size);
+    CHECK(ctl.cooldown_cur() == 30*SEC);
+}
+
+static void test_demotion_shrinks() {
+    llama_kv_pool_ctl ctl(policy());
+    int64_t t = SEC;
+    CHECK(ctl.decide(snap(t, 1000, 13000, 7000), 1024*MiB, t).size == 0);
+    // 600 MiB of this process moved to system memory: its local usage fell, its budget looks fine
+    t += SEC/4;
+    auto d = ctl.decide(snap(t, 1000, 12400, 7600), 1024*MiB, t);
+    CHECK(d.why == llama_kv_pool_ctl::SHRINK_DEMOTED);
+    CHECK(d.demoted == 600*MiB);
+    CHECK(d.size == (1024 - (512 - 400) - 128)*MiB);
+    ctl.on_resized(t, 1024*MiB, d.size);
+    // no grow while the demoted memory has not come back (1300 free - 600 demoted is inside the hysteresis band)
+    size_t cur = d.size;
+    for (t += SEC; t < 300*SEC; t += SEC) {
+        CHECK(ctl.decide(snap(t, 1300, 12400, 7600), cur, t).why == llama_kv_pool_ctl::KEEP);
+    }
+    // it came back: the baseline drops, and the pool may grow again
+    for (t += SEC; t < 340*SEC; t += SEC) {
+        d = ctl.decide(snap(t, 1400, 13000, 7000), cur, t);
+        if (d.size) {
+            break;
+        }
+    }
+    CHECK(d.why == llama_kv_pool_ctl::GROW);
+}
+
+static void test_host_allocation_is_not_a_demotion() {
+    llama_kv_pool_ctl ctl(policy());
+    int64_t t = SEC;
+    ctl.decide(snap(t, 1000, 13000, 7000), 1024*MiB, t);
+    // 200 MiB more pinned host memory, local usage unchanged
+    t += SEC/4;
+    auto d = ctl.decide(snap(t, 1000, 13000, 7200), 1024*MiB, t);
+    CHECK(d.size == 0 && d.demoted == 0);
+}
+
+static void test_growth_across_resize_is_a_demotion() {
+    llama_kv_pool_ctl ctl(policy());
+    int64_t t = SEC;
+    ctl.decide(snap(t, 1000, 13000, 7000), 1024*MiB, t);
+    ctl.on_resized(t, 1024*MiB, 1280*MiB);
+    // the pool grew by 256 MiB, but only 56 MiB of it landed in local memory (first snapshot after the settle time)
+    t += SEC;
+    auto d = ctl.decide(snap(t, 600, 13056, 7200), 1280*MiB, t);
+    CHECK(d.demoted == 200*MiB && d.why == llama_kv_pool_ctl::SHRINK_DEMOTED);
+    CHECK(d.size == (1280 - 240)*MiB);
+}
+
+static void test_snapshot_during_resize_is_skipped() {
+    llama_kv_pool_ctl ctl(policy());
+    ctl.decide(snap(1000000, 1000, 13000, 7000), 1024*MiB, 1000000);
+    // a grow ran from 1.1 s to 1.3 s; the monitor's snapshot at 1.2 s saw the old pool freed
+    ctl.on_resized(1300000, 1024*MiB, 1280*MiB);
+    auto d = ctl.decide(snap(1200000, 2000, 12900, 7000), 1280*MiB, 1300000);
+    CHECK(d.size == 0);
+    // the first snapshot after the resize still compares against the one before it: 200 MiB landed in system memory
+    d = ctl.decide(snap(1900000, 600, 13056, 7200), 1280*MiB, 1900000);
+    CHECK(d.demoted == 200*MiB && d.why == llama_kv_pool_ctl::SHRINK_DEMOTED);
+}
+
+static void test_lost_pool_regrows_to_min() {
+    // both resizes failed (the pool is 0): the first grow brings back at least min_size, not one grow_step
+    llama_kv_pool_policy p = policy();
+    p.min_size = 400*MiB;
+    llama_kv_pool_ctl ctl(p);
+    int64_t t = SEC;
+    CHECK(ctl.decide(snap(t, 3000), 0, t).why == llama_kv_pool_ctl::KEEP);
+    t += 5*SEC;
+    auto d = ctl.decide(snap(t, 3000), 0, t);
+    CHECK(d.why == llama_kv_pool_ctl::GROW && d.size == 400*MiB);
+}
+
+int main() {
+    test_invalid_keeps();
+    test_grows_in_steps_after_delay();
+    test_grow_leaves_hysteresis();
+    test_no_grow_while_held_back();
+    test_hysteresis_band_keeps();
+    test_shrinks_at_once();
+    test_shrink_accounts_for_slots();
+    test_cooldown_after_shrink();
+    test_flapping_doubles_cooldown_once_and_resets();
+    test_demotion_shrinks();
+    test_host_allocation_is_not_a_demotion();
+    test_growth_across_resize_is_a_demotion();
+    test_snapshot_during_resize_is_skipped();
+    test_lost_pool_regrows_to_min();
+    printf("test-kv-pool-ctl: OK\n");
+    return 0;
+}
diff --git a/tests/test-kv-stream-place.cpp b/tests/test-kv-stream-place.cpp
new file mode 100644
index 0000000..a1787dd
--- /dev/null
+++ b/tests/test-kv-stream-place.cpp
@@ -0,0 +1,507 @@
+// KV streaming: which pages hold the pool slots before a ubatch (src/llama-kv-stream-place.h), without a GPU
+
+#include "../src/llama-kv-stream-place.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+#include <vector>
+
+#define CHECK(cond) do { if (!(cond)) { fprintf(stderr, "%s:%d: CHECK(%s) failed\n", __FILE__, __LINE__, #cond); exit(1); } } while (0)
+
+static constexpr uint32_t PAGE    = 256;
+static constexpr uint32_t N_PAGES = 1024; // the production 262,144-token context
+static constexpr uint32_t MARGIN  = llama_kv_stream_stale_margin;
+
+static constexpr llama_kv_stream_rereside OFF    = LLAMA_KV_STREAM_RERESIDE_OFF;
+static constexpr llama_kv_stream_rereside UNFIT  = LLAMA_KV_STREAM_RERESIDE_UNFIT;
+static constexpr llama_kv_stream_rereside ALWAYS = LLAMA_KV_STREAM_RERESIDE_ALWAYS;
+
+// one page move, as llama_kv_stream applies it
+struct move {
+    char     op; // 'e' evict, 'd' drop, 'a' assign
+    uint32_t page;
+    uint32_t slot;
+
+    bool operator==(const move & o) const { return op == o.op && page == o.page && slot == o.slot; }
+};
+
+// what one ubatch attended
+struct ub_step {
+    uint32_t n_streamed; // attended pages that stream
+    bool     fits;       // the attended pages fit the pool
+    bool     decode;     // a decode ubatch (the paged decode kernel, up to 96 tokens)
+};
+
+// the page table of llama_kv_stream, and the used cells of the cache in front of it
+struct table {
+    std::vector<int32_t> page_slot;
+    std::vector<int32_t> slot_page;
+    std::vector<move>    moves;
+    std::vector<ub_step> steps;        // every ubatch
+    uint32_t             n_used   = 0; // llama_kv_cells::used_max_p1
+    uint32_t             max_runs = 0; // the most runs a prefill ubatch attended (request() resets it)
+
+    explicit table(uint32_t n_slots) : page_slot(N_PAGES, -1), slot_page(n_slots, -1) {}
+
+    void evict(uint32_t p) {
+        CHECK(page_slot[p] >= 0);
+        moves.push_back({ 'e', p, (uint32_t) page_slot[p] });
+        slot_page[page_slot[p]] = -1;
+        page_slot[p] = -1;
+    }
+    void drop(uint32_t p) {
+        CHECK(page_slot[p] >= 0);
+        moves.push_back({ 'd', p, (uint32_t) page_slot[p] });
+        slot_page[page_slot[p]] = -1;
+        page_slot[p] = -1;
+    }
+    void assign(uint32_t p, uint32_t s) {
+        CHECK(page_slot[p] < 0 && slot_page[s] < 0);
+        moves.push_back({ 'a', p, s });
+        page_slot[p] = s;
+        slot_page[s] = p;
+    }
+
+    // a ubatch writes cells [c0, c1) (llama_kv_cache_context::apply: the cells, then get_n_kv, then prepare): the moves,
+    // and the attended pages that stream
+    uint32_t ubatch(uint32_t c0, uint32_t c1, llama_kv_stream_rereside mode, bool reference = false) {
+        const uint32_t n_slots = (uint32_t) slot_page.size();
+        n_used = std::max(n_used, c1);
+        const uint32_t n_att = std::min(N_PAGES, std::max(1u, (n_used + PAGE - 1)/PAGE));
+        std::vector<uint8_t> written(N_PAGES, 0);
+        for (uint32_t c = c0; c < c1; ++c) {
+            written[c/PAGE] = 1;
+        }
+        // while the attended pages fit the pool, UNFIT makes the moves of the policy before rereside
+        const bool acts = mode == ALWAYS || (mode == UNFIT && n_att > n_slots);
+        table before(n_slots);
+        if (mode == UNFIT && !acts) {
+            before.page_slot = page_slot;
+            before.slot_page = slot_page;
+            before.place_before(written, n_att);
+        }
+        const size_t m0 = moves.size();
+        if (reference) {
+            place_before(written, n_att);
+        } else {
+            llama_kv_stream_place(page_slot, slot_page, written, n_att, mode,
+                    [this](uint32_t p) { evict(p); },
+                    [this](uint32_t p) { drop(p); },
+                    [this](uint32_t p, uint32_t s) { assign(p, s); });
+        }
+        check(written, n_att, acts && !reference, m0);
+        if (mode == UNFIT && !acts && !reference) {
+            CHECK(moves.size() - m0 == before.moves.size());
+            for (size_t i = 0; i < before.moves.size(); ++i) {
+                CHECK(moves[m0 + i] == before.moves[i]);
+            }
+        }
+        uint32_t n_streamed = 0;
+        for (uint32_t p = 0; p < n_att; ++p) {
+            n_streamed += page_slot[p] < 0;
+        }
+        if (c1 - c0 > 96) {
+            max_runs = std::max(max_runs, runs(n_att));
+        }
+        steps.push_back({ n_streamed, n_att <= n_slots, c1 - c0 <= 96 });
+        return n_streamed;
+    }
+
+    // the runs the paged prefill attends as separate parts (llama_kv_stream::prepare's run_list): consecutive pages in
+    // consecutive pool slots, or streamed (packed in the ring)
+    uint32_t runs(uint32_t n_att) const {
+        uint32_t res = 0;
+        bool     pool_prev = false;
+        int64_t  pos_prev  = -2;
+        int64_t  ring      = 0;
+        for (uint32_t p = 0; p < n_att; ++p) {
+            const bool    pool = page_slot[p] >= 0;
+            const int64_t pos  = pool ? page_slot[p] : ring++;
+            if (p == 0 || pool != pool_prev || pos != pos_prev + 1) {
+                res++;
+            }
+            pool_prev = pool;
+            pos_prev  = pos;
+        }
+        return res;
+    }
+
+    // llama_kv_stream::prepare before llama-kv-stream-place.h, verbatim but for the page moves
+    void place_before(const std::vector<uint8_t> & written, uint32_t n_att) {
+        const uint32_t n_slots = (uint32_t) slot_page.size();
+        uint32_t free_slot = 0;
+        auto next_free = [&]() {
+            while (free_slot < n_slots && slot_page[free_slot] >= 0) {
+                free_slot++;
+            }
+            return free_slot;
+        };
+        for (uint32_t p = 0; p < N_PAGES; ++p) {
+            if (!written[p] || page_slot[p] >= 0) {
+                continue;
+            }
+            uint32_t slot = next_free();
+            if (slot == n_slots) {
+                uint32_t victim = 0;
+                while (victim < N_PAGES && (page_slot[victim] < 0 || written[victim])) {
+                    victim++;
+                }
+                CHECK(victim < N_PAGES);
+                slot = page_slot[victim];
+                evict(victim);
+            }
+            assign(p, slot);
+        }
+        for (uint32_t p = n_att; p-- > 0 && next_free() < n_slots; ) {
+            if (page_slot[p] < 0) {
+                assign(p, next_free());
+            }
+        }
+    }
+
+    // rereside: the stale pages gave their slots up in this ubatch
+    void check(const std::vector<uint8_t> & written, uint32_t n_att, bool rereside, size_t m0) const {
+        const uint32_t n_slots = (uint32_t) slot_page.size();
+        // the page table is consistent
+        for (uint32_t p = 0; p < N_PAGES; ++p) {
+            if (page_slot[p] >= 0) {
+                CHECK((uint32_t) page_slot[p] < n_slots && slot_page[page_slot[p]] == (int32_t) p);
+            }
+        }
+        for (uint32_t s = 0; s < n_slots; ++s) {
+            if (slot_page[s] >= 0) {
+                CHECK(page_slot[slot_page[s]] == (int32_t) s);
+            }
+        }
+        // every written page is resident
+        for (uint32_t p = 0; p < N_PAGES; ++p) {
+            CHECK(!written[p] || page_slot[p] >= 0);
+        }
+        // only stale pages are dropped: past the attended ones, and not written (their cells are empty); a stale page is
+        // never written back (only the margin page past n_att may be evicted), and nothing is dropped without rereside
+        for (size_t i = m0; i < moves.size(); ++i) {
+            if (moves[i].op == 'd') {
+                CHECK(rereside);
+                CHECK(moves[i].page >= n_att + MARGIN && !written[moves[i].page]);
+            }
+            if (moves[i].op == 'e' && rereside) {
+                CHECK(moves[i].page < n_att + MARGIN);
+            }
+        }
+        if (!rereside) {
+            return;
+        }
+        // with rereside, a stale page stays resident only while no attended page streams
+        bool streams = false;
+        for (uint32_t p = 0; p < n_att; ++p) {
+            streams = streams || page_slot[p] < 0;
+        }
+        if (streams) {
+            for (uint32_t p = n_att + MARGIN; p < N_PAGES; ++p) {
+                CHECK(page_slot[p] < 0);
+            }
+            // and the pool is full of attended pages, but for the margin
+            uint32_t n_res = 0;
+            for (uint32_t p = 0; p < n_att; ++p) {
+                n_res += page_slot[p] >= 0;
+            }
+            CHECK(n_res + MARGIN >= n_slots);
+        }
+    }
+
+    // memory_seq_rm [p0, end) of the only sequence: the cells past p0 are empty, the pages stay where they are
+    void cut(uint32_t p0) { n_used = std::min(n_used, p0); }
+
+    // a session state loaded from the prompt cache (its n_state cells from 0) and cut to its last checkpoint at p0: the
+    // load writes the rows where the pages live (llama_kv_stream::set_rows) and moves no page
+    void reload(uint32_t n_state, uint32_t p0) {
+        cut(0);
+        n_used = n_state;
+        cut(p0);
+    }
+
+    // a prefill of [c0, c1) in ubatches of 512
+    void prefill(uint32_t c0, uint32_t c1, llama_kv_stream_rereside mode, bool reference = false) {
+        for (uint32_t c = c0; c < c1; c += 512) {
+            ubatch(c, std::min(c1, c + 512), mode, reference);
+        }
+    }
+
+    // a prefill of [c0, c1), then n_gen decode tokens: the attended pages that stream at the last one
+    uint32_t request(uint32_t c0, uint32_t c1, uint32_t n_gen, llama_kv_stream_rereside mode, bool reference = false) {
+        max_runs = 0;
+        prefill(c0, c1, mode, reference);
+        uint32_t n_streamed = 0;
+        for (uint32_t i = 0; i < n_gen; ++i) {
+            n_streamed = ubatch(c1 + i, c1 + i + 1, mode, reference);
+        }
+        return n_streamed;
+    }
+
+    // a prefill of [c0, c1), then n_steps of speculative decoding: each verifies 4 drafted tokens (a 5-token ubatch) and
+    // keeps 2, the rest is cut again. Returns the end of the context
+    uint32_t request_spec(uint32_t c0, uint32_t c1, uint32_t n_steps, llama_kv_stream_rereside mode) {
+        prefill(c0, c1, mode);
+        uint32_t n = c1;
+        for (uint32_t i = 0; i < n_steps; ++i) {
+            ubatch(n, n + 5, mode);
+            cut(n + 2);
+            n += 2;
+        }
+        return n;
+    }
+};
+
+int main() {
+    // without rereside, the moves are exactly those of the policy before it, also around cuts
+    {
+        std::mt19937 rng(42);
+        for (int iter = 0; iter < 20; ++iter) {
+            const uint32_t n_slots = 8 + rng() % 400;
+            table a(n_slots);
+            table b(n_slots);
+            uint32_t n = 0;
+            for (int step = 0; step < 40; ++step) {
+                const uint32_t r = rng() % 4;
+                if (r == 0 && n > 0) {
+                    const uint32_t p0 = rng() % n;
+                    a.cut(p0);
+                    b.cut(p0);
+                    n = p0;
+                } else {
+                    const uint32_t len = r == 1 ? 1 + rng() % 3000 : 1 + rng() % 5;
+                    if (n + len > N_PAGES*PAGE) {
+                        continue;
+                    }
+                    for (uint32_t c = n; c < n + len; c += 512) {
+                        a.ubatch(c, std::min(n + len, c + 512), OFF);
+                        b.ubatch(c, std::min(n + len, c + 512), OFF, true);
+                    }
+                    n += len;
+                }
+            }
+            CHECK(a.moves.size() == b.moves.size());
+            for (size_t i = 0; i < a.moves.size(); ++i) {
+                CHECK(a.moves[i] == b.moves[i]);
+            }
+        }
+    }
+
+    // a context that only grows has no stale pages: rereside moves the same pages
+    for (llama_kv_stream_rereside mode : { UNFIT, ALWAYS }) {
+        table a(230);
+        table b(230);
+        a.request(0, 95596, 240, mode);
+        b.request(0, 95596, 240, OFF);
+        CHECK(a.moves.size() == b.moves.size());
+        for (size_t i = 0; i < a.moves.size(); ++i) {
+            CHECK(a.moves[i] == b.moves[i]);
+        }
+    }
+
+    // the 10-29 pool search (runs/pool_mtp/server_*.log), per pool of P pages (6.5 MiB each): a 96k request, a 143k
+    // request that keeps 30 cached tokens, the 96k state loaded back from the prompt cache (its 95,838 cells from 0, cut
+    // to the 95,592 of its last checkpoint; the 4 others prefilled again), the 143k request again, then short chats
+    for (uint32_t n_slots : { 92u, 153u, 184u, 215u, 230u }) {
+        uint32_t streamed[3][4] = {};
+        for (llama_kv_stream_rereside mode : { OFF, UNFIT, ALWAYS }) {
+            uint32_t * s = streamed[mode];
+            table t(n_slots);
+            s[0] = t.request(0, 95596, 240, mode);
+            t.cut(30);
+            t.request(30, 143289, 80, mode);
+            t.reload(95838, 95592);
+            s[1] = t.request(95592, 95596, 183, mode);
+            t.cut(30);
+            t.request(30, 143289, 248, mode);
+            t.cut(0);
+            s[2] = t.request(0, 9243, 50, mode);
+            t.cut(9239);
+            s[3] = t.request(9239, 11904, 92, mode);
+        }
+        printf("pool %3u pages: streamed per decode step, unfit / always / off: 96k %3u / %3u / %3u, "
+                "96k from the prompt cache %3u / %3u / %3u, 9k chat %2u / %2u / %2u, 12k chat %2u / %2u / %2u\n", n_slots,
+                streamed[UNFIT][0], streamed[ALWAYS][0], streamed[OFF][0], streamed[UNFIT][1], streamed[ALWAYS][1],
+                streamed[OFF][1], streamed[UNFIT][2], streamed[ALWAYS][2], streamed[OFF][2], streamed[UNFIT][3],
+                streamed[ALWAYS][3], streamed[OFF][3]);
+        const uint32_t n_96k = (95596 + 240 + PAGE - 1)/PAGE;
+        // the first 96k request streams what the pool cannot hold, with or without rereside
+        for (int m = 0; m < 3; ++m) {
+            CHECK(streamed[m][0] == n_96k - n_slots);
+        }
+        // without: the pool kept the 143k tail (561 pages), of which n_slots - 186 pages at most lie in the 96k context,
+        // plus the 2 pages the reloaded request writes
+        CHECK(streamed[OFF][1] + 2 >= n_96k - (n_slots > 186 ? n_slots - 186 : 0));
+        // with rereside, the reloaded 96k streams no more than the first one did (but for the margin page)
+        CHECK(streamed[UNFIT][1] <= n_96k - n_slots + MARGIN && streamed[ALWAYS][1] <= n_96k - n_slots + MARGIN);
+        // short chats fit every pool: the long context's tail made them stream; ALWAYS streams nothing there, UNFIT
+        // streams as without rereside
+        CHECK(streamed[OFF][2] > 0);
+        CHECK(streamed[ALWAYS][2] == 0 && streamed[ALWAYS][3] == 0);
+        CHECK(streamed[UNFIT][2] == streamed[OFF][2] && streamed[UNFIT][3] == streamed[OFF][3]);
+    }
+
+    // the 10-30 A/B (opt/step7/server_seq_*.log; IQ3_S, 600 MiB = 92 pages), per pool: long_test 64000, 96000, 64000,
+    // 96000 (a 96k request, 143k, the 96k state reloaded from the prompt cache, 143k), then agent turns of 9-13k tokens that
+    // cut and extend one session, other sessions reloaded from the prompt cache, and chats, all with speculative
+    // decoding. In this sequence, with UNFIT, every ubatch streams no more pages than without rereside (but for the margin
+    // page); while the attended pages fit the pool, it streams pages if and only if it does without rereside, and every
+    // decode step streams exactly as many. ALWAYS streamed none there, and those agent turns decoded 3-8 % slower per step
+    // than with the 35-50 pages streaming without rereside. (Equal counts are particular to this sequence: in general an
+    // earlier re-plan can leave other pages resident, so a step that fits may stream fewer, or a prefill a few more; what
+    // holds in general is checked per ubatch above: the same moves for the same page table while the pages fit.)
+    for (uint32_t n_slots : { 92u, 153u, 230u }) {
+        table t[3] = { table(n_slots), table(n_slots), table(n_slots) };
+        // per mode: the decode steps of the reloaded 96k, and of the requests after the second 143k
+        uint64_t reload_streamed[3] = {};
+        uint64_t agent_streamed[3]  = {};
+        uint32_t reload_steps = 0;
+        uint32_t agent_steps  = 0;
+        for (int m = 0; m < 3; ++m) {
+            const llama_kv_stream_rereside mode = (llama_kv_stream_rereside) m;
+            table & tm = t[m];
+            auto decoded = [&](size_t s0, uint64_t & sum, uint32_t & n_steps, uint32_t n_spec) {
+                // the last n_spec steps are the decode steps
+                for (size_t i = tm.steps.size() - n_spec; i < tm.steps.size(); ++i) {
+                    sum += tm.steps[i].n_streamed;
+                }
+                if (m == 0) {
+                    n_steps += n_spec;
+                }
+                CHECK(tm.steps.size() - s0 >= n_spec);
+            };
+            uint32_t n = tm.request_spec(0, 95596, 40, mode);
+            tm.cut(30);
+            n = tm.request_spec(30, 143259, 40, mode);
+            // the 96k state from the prompt cache: 95,727 cells, cut to its checkpoint at 95,592; 4 tokens prefilled
+            tm.reload(95727, 95592);
+            size_t s0 = tm.steps.size();
+            n = tm.request_spec(95592, 95596, 30, mode);
+            decoded(s0, reload_streamed[m], reload_steps, 30);
+            tm.cut(30);
+            n = tm.request_spec(30, 143259, 70, mode);
+            // agent turns: a new 9.2k session, then turns that cut the last answer back a little and append
+            struct turn { uint32_t keep, end, n_steps; };
+            const turn turns[] = {
+                { 0, 9243, 10 }, { 9248, 11913, 14 }, { 11940, 12832, 75 }, { 12844, 13206, 20 }, { 13220, 13356, 25 },
+            };
+            for (const turn & tr : turns) {
+                tm.cut(tr.keep);
+                s0 = tm.steps.size();
+                n = tm.request_spec(tr.keep, tr.end, tr.n_steps, mode);
+                decoded(s0, agent_streamed[m], agent_steps, tr.n_steps);
+            }
+            // sessions reloaded from the prompt cache in turn, each extended by a turn
+            const turn reloads[] = { { 10250, 10600, 40 }, { 13400, 13700, 40 }, { 10650, 11000, 30 }, { 13750, 14200, 30 } };
+            for (const turn & tr : reloads) {
+                tm.reload(tr.keep + 30, tr.keep);
+                s0 = tm.steps.size();
+                n = tm.request_spec(tr.keep, tr.end, tr.n_steps, mode);
+                decoded(s0, agent_streamed[m], agent_steps, tr.n_steps);
+            }
+            // chats on a fresh context
+            tm.cut(0);
+            n = tm.request_spec(0, 55, 3, mode);
+            tm.cut(40);
+            n = tm.request_spec(40, 78, 100, mode);
+            CHECK(n > 0);
+        }
+        const std::vector<ub_step> & off = t[OFF].steps;
+        CHECK(t[UNFIT].steps.size() == off.size() && t[ALWAYS].steps.size() == off.size());
+        uint32_t n_fit_streaming = 0; // decode steps that fit the pool and stream without rereside
+        for (size_t i = 0; i < off.size(); ++i) {
+            const ub_step & u = t[UNFIT].steps[i];
+            CHECK(u.fits == off[i].fits && u.decode == off[i].decode);
+            CHECK(u.n_streamed <= off[i].n_streamed + MARGIN);
+            if (off[i].fits) {
+                CHECK((u.n_streamed > 0) == (off[i].n_streamed > 0));
+                if (off[i].decode) {
+                    CHECK(u.n_streamed == off[i].n_streamed);
+                    n_fit_streaming += off[i].n_streamed > 0;
+                }
+            }
+            // ALWAYS never streams more either: the regression it caused was streaming less
+            CHECK(t[ALWAYS].steps[i].n_streamed <= off[i].n_streamed + MARGIN);
+        }
+        printf("pool %3u pages: mean streamed per decode step, unfit / always / off: reloaded 96k %5.1f / %5.1f / %5.1f, "
+                "agent turns and reloads %4.1f / %4.1f / %4.1f; %u decode steps fit the pool and stream without rereside\n",
+                n_slots, (double) reload_streamed[UNFIT]/reload_steps, (double) reload_streamed[ALWAYS]/reload_steps,
+                (double) reload_streamed[OFF]/reload_steps, (double) agent_streamed[UNFIT]/agent_steps,
+                (double) agent_streamed[ALWAYS]/agent_steps, (double) agent_streamed[OFF]/agent_steps, n_fit_streaming);
+        // the target case still gains, by the stale pages it re-plans
+        const uint32_t n_96k = (95596 + 60 + PAGE - 1)/PAGE;
+        CHECK(reload_streamed[UNFIT] <= (uint64_t) (n_96k - n_slots + MARGIN)*reload_steps);
+        CHECK(reload_streamed[UNFIT] < reload_streamed[OFF]);
+        // the agent turns stream as without rereside, which ALWAYS did not
+        CHECK(agent_streamed[UNFIT] == agent_streamed[OFF]);
+        CHECK(agent_streamed[OFF] > 0 && agent_streamed[ALWAYS] == 0);
+        CHECK(n_fit_streaming > 0);
+    }
+
+    // the slots handed out after a shrink keep consecutive pages in consecutive slots: a prefill ubatch attends a few
+    // runs (each a part and a merge of the paged prefill), as without rereside, not one per page
+    for (uint32_t n_slots : { 92u, 153u, 230u }) {
+        uint32_t runs[3] = {};
+        for (llama_kv_stream_rereside mode : { OFF, UNFIT, ALWAYS }) {
+            table t(n_slots);
+            auto req = [&](uint32_t c0, uint32_t c1, uint32_t n_gen) {
+                t.request(c0, c1, n_gen, mode);
+                runs[mode] = std::max(runs[mode], t.max_runs);
+            };
+            req(0, 95596, 240);
+            t.cut(30);
+            req(30, 143289, 80);
+            // the 96k state reloaded and cut further back, then a 1024-token prefill
+            t.reload(95838, 95000);
+            req(95000, 96024, 100);
+            t.cut(30);
+            req(30, 143289, 248);
+            t.cut(0);
+            req(0, 30000, 50);
+        }
+        printf("pool %3u pages: the most runs a prefill ubatch attends, unfit / always / off: %u / %u / %u\n", n_slots,
+                runs[UNFIT], runs[ALWAYS], runs[OFF]);
+        for (llama_kv_stream_rereside mode : { UNFIT, ALWAYS }) {
+            CHECK(runs[mode] <= 8 && runs[mode] <= runs[OFF] + 2);
+        }
+    }
+
+    // random requests, cuts and restores: the invariants of table::check hold (and with UNFIT, the moves of the policy
+    // before rereside while the attended pages fit the pool); with ALWAYS nothing streams that fits the pool
+    for (llama_kv_stream_rereside mode : { UNFIT, ALWAYS }) {
+        std::mt19937 rng(7);
+        for (int iter = 0; iter < 20; ++iter) {
+            const uint32_t n_slots = 8 + rng() % 600;
+            table t(n_slots);
+            uint32_t n = 0;
+            for (int step = 0; step < 30; ++step) {
+                const uint32_t r = rng() % 3;
+                if (r == 0) {
+                    // a cut, or a state restored in its place (every cell cut, the state's cells used from 0)
+                    uint32_t p0 = n > 0 ? rng() % n : 0;
+                    t.cut(p0);
+                    if (rng() % 2) {
+                        p0 = std::min<uint32_t>(N_PAGES*PAGE - 4096, rng() % (200*1024));
+                        t.n_used = p0;
+                    }
+                    n = p0;
+                } else {
+                    const uint32_t len = r == 1 ? 1 + rng() % 40000 : 1 + rng() % 5;
+                    if (n + len + 64 > N_PAGES*PAGE) {
+                        continue;
+                    }
+                    const uint32_t n_streamed = t.request(n, n + len, 4, mode);
+                    n += len + 4;
+                    if (mode == ALWAYS && (n + PAGE - 1)/PAGE + MARGIN <= n_slots) {
+                        CHECK(n_streamed == 0);
+                    }
+                }
+            }
+        }
+    }
+
+    printf("%s: OK\n", __FILE__);
+    return 0;
+}
diff --git a/tests/test-kv-stream-split.cpp b/tests/test-kv-stream-split.cpp
new file mode 100644
index 0000000..944fb63
--- /dev/null
+++ b/tests/test-kv-stream-split.cpp
@@ -0,0 +1,438 @@
+// KV streaming: the split of one device budget between the resident pool and the streaming slots
+// (src/llama-kv-stream-split.h), without a GPU
+
+#include "../src/llama-kv-stream-split.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <list>
+#include <vector>
+
+static constexpr size_t MiB = 1024*1024;
+
+#define CHECK(cond) do { if (!(cond)) { fprintf(stderr, "%s:%d: CHECK(%s) failed\n", __FILE__, __LINE__, #cond); exit(1); } } while (0)
+
+// the production model (Swift 1.5 / Qwen3.8-27B): 16 attention layers, K q8_0 and V q4_0 with 4 KV heads of 256
+// = 1664 bytes per token per layer; a 262,144-token context
+static constexpr uint32_t PAGE      = 256;
+static constexpr size_t   ROW       = 1088 + 576;
+static constexpr size_t   PAGE_POOL = 16*ROW*PAGE; // K and V of every layer: 6.5 MiB
+static constexpr size_t   PAGE_RING = 2*ROW*PAGE;  // K and V of one layer, in both slots: 0.8125 MiB
+static constexpr uint32_t N_PAGES   = 1024;
+
+static uint32_t pages(uint32_t n_tokens) {
+    return (n_tokens + PAGE - 1)/PAGE;
+}
+
+// the split of `budget` never takes more than the budget, and its ring holds what streams for n_need pages
+static void check_split(size_t budget, uint32_t n_need) {
+    const llama_kv_stream_split s = llama_kv_stream_split_budget(budget, N_PAGES, n_need, PAGE_POOL, PAGE_RING);
+    if (s.n_ring == 0) {
+        CHECK(s.n_slots == 0);
+        CHECK(budget <= (size_t) n_need*PAGE_RING);
+        return;
+    }
+    // (a pool below 8 pages is rejected by the cache, not here)
+    CHECK(s.bytes(PAGE_POOL, PAGE_RING) <= budget);
+    CHECK(s.n_slots <= N_PAGES);
+    CHECK(s.n_ring >= 1);
+    // the split holds what streams for n_need attended pages
+    CHECK(!llama_kv_stream_split_outgrown(n_need, s.n_slots, s.n_ring));
+    CHECK(n_need - std::min(n_need, s.n_slots) <= s.n_ring);
+    // and the pool is as large as it can be: one more pool page would not leave the ring it needs
+    if (s.n_slots < N_PAGES) {
+        const uint32_t n_ring_more = n_need > s.n_slots + 1 ? n_need - s.n_slots - 1 : 1;
+        CHECK((size_t) (s.n_slots + 1)*PAGE_POOL + (size_t) n_ring_more*PAGE_RING > budget);
+    }
+}
+
+// the tensors a split places in its arena, one page each: K and V of every layer in the pool, K and V of both slots
+static const size_t POOL_T[32] = {
+    1088*PAGE, 576*PAGE, 1088*PAGE, 576*PAGE, 1088*PAGE, 576*PAGE, 1088*PAGE, 576*PAGE,
+    1088*PAGE, 576*PAGE, 1088*PAGE, 576*PAGE, 1088*PAGE, 576*PAGE, 1088*PAGE, 576*PAGE,
+    1088*PAGE, 576*PAGE, 1088*PAGE, 576*PAGE, 1088*PAGE, 576*PAGE, 1088*PAGE, 576*PAGE,
+    1088*PAGE, 576*PAGE, 1088*PAGE, 576*PAGE, 1088*PAGE, 576*PAGE, 1088*PAGE, 576*PAGE,
+};
+static const size_t RING_T[4] = { 1088*PAGE, 576*PAGE, 1088*PAGE, 576*PAGE };
+
+// every split of `budget` (and the pool alone, as the cache places it before the first split) fits the arena allocated
+// for the budget, whatever the alignment and the allocator's extra bytes per tensor
+static void check_arena(size_t budget, size_t align, size_t extra_each) {
+    // a budget beyond the whole context gets an arena of the context
+    const size_t arena_budget = llama_kv_stream_split_arena_budget(budget, N_PAGES, PAGE_POOL, PAGE_RING);
+    CHECK(arena_budget == std::min(budget, (size_t) N_PAGES*PAGE_POOL + PAGE_RING));
+    const size_t arena = llama_kv_stream_split_arena_size(arena_budget, 36, 36*extra_each, align);
+    CHECK(arena - arena_budget <= 36*(align + extra_each));
+
+    llama_kv_stream_split first;
+    first.n_slots = std::min<uint32_t>(N_PAGES, (uint32_t) (budget/PAGE_POOL));
+    first.n_ring  = 0;
+    CHECK(llama_kv_stream_split_placed(first, POOL_T, 32, RING_T, 4, extra_each, align) <= arena);
+
+    for (uint32_t n_need = 1; n_need <= N_PAGES; ++n_need) {
+        const llama_kv_stream_split s = llama_kv_stream_split_budget(budget, N_PAGES, n_need, PAGE_POOL, PAGE_RING);
+        if (s.n_ring == 0) {
+            continue;
+        }
+        CHECK(llama_kv_stream_split_placed(s, POOL_T, 32, RING_T, 4, 0, 1) == s.bytes(PAGE_POOL, PAGE_RING));
+        CHECK(llama_kv_stream_split_placed(s, POOL_T, 32, RING_T, 4, extra_each, align) <= arena);
+    }
+}
+
+// places tensors in the regions of a chunked arena as llama_kv_stream_arena::place does: at the cursor, rounded up to
+// `align`, or at the start of the next region; false if no region is left
+struct region_placer {
+    const std::vector<size_t> & regions;
+    size_t align;
+    size_t region = 0;
+    size_t offset = 0;
+
+    bool place(size_t size) {
+        for (; region < regions.size(); ++region, offset = 0) {
+            const size_t off = llama_kv_stream_pad(offset, align);
+            if (off + size <= regions[region]) {
+                offset = off + size;
+                return true;
+            }
+        }
+        return false;
+    }
+};
+
+// every split of `budget` fits a chunked arena: the slots first, then the pool, as resize_kv_stream places them (and the
+// pool alone, as the cache places it before the first split); the regions sized as llama_kv_cache::split_arena_regions
+static void check_chunked_arena(size_t budget, size_t align, size_t extra_each, size_t chunk) {
+    const size_t arena_budget = llama_kv_stream_split_arena_budget(budget, N_PAGES, PAGE_POOL, PAGE_RING);
+    const size_t size = llama_kv_stream_split_arena_size(arena_budget, 36, 36*extra_each, align);
+
+    const size_t n_pool_max = std::min<size_t>(N_PAGES, arena_budget/PAGE_POOL);
+    const size_t pool_t_max = 1088*PAGE*n_pool_max + extra_each;
+    const size_t slot_k     = 1088*PAGE*N_PAGES + extra_each;
+    const size_t slot_v     =  576*PAGE*N_PAGES + extra_each;
+    const size_t slots_max  = 2*(llama_kv_stream_pad(slot_k, align) + llama_kv_stream_pad(slot_v, align));
+    const size_t waste      = llama_kv_stream_split_arena_waste(pool_t_max, slots_max, slot_k, chunk, align);
+
+    const std::vector<size_t> regions = llama_kv_stream_arena_regions(size, chunk, waste, align);
+    size_t total = 0;
+    for (size_t r : regions) {
+        CHECK(r % align == 0);
+        CHECK(r <= llama_kv_stream_pad(std::max(chunk, 2*waste), align));
+        total += r;
+    }
+    CHECK(total >= size);
+    if (size <= chunk) {
+        CHECK(regions.size() == 1);
+    } else {
+        // the slack: one waste per region boundary
+        CHECK(total - size <= (regions.size() - 1)*waste + align);
+    }
+
+    const auto check = [&](const llama_kv_stream_split & s, bool slots) {
+        region_placer p = { regions, align };
+        if (slots) {
+            for (size_t t : RING_T) {
+                CHECK(p.place(t*s.n_ring + extra_each));
+            }
+        }
+        for (size_t t : POOL_T) {
+            CHECK(p.place(t*s.n_slots + extra_each));
+        }
+    };
+
+    llama_kv_stream_split first;
+    first.n_slots = (uint32_t) std::min<size_t>(N_PAGES, budget/PAGE_POOL);
+    check(first, false);
+
+    for (uint32_t n_need = 1; n_need <= N_PAGES; ++n_need) {
+        const llama_kv_stream_split s = llama_kv_stream_split_budget(budget, N_PAGES, n_need, PAGE_POOL, PAGE_RING);
+        if (s.n_ring > 0) {
+            check(s, true);
+        }
+    }
+}
+
+// The HIP runtime on Windows (ROCclr's PAL backend, ResourceCache in palresource.cpp): a freed device allocation below
+// the cache limit (an eighth of the VRAM) stays committed to the process, newest first, and is handed out again only for
+// a request of more than half its size and at most its size. Sizes in bytes; a block keeps the size it was created with.
+struct pal_allocator {
+    size_t limit;
+    std::list<size_t> cache; // newest first
+    size_t live   = 0;
+    size_t cached = 0;
+    size_t peak   = 0;
+
+    explicit pal_allocator(size_t limit) : limit(limit) {}
+
+    size_t committed() const { return live + cached; }
+
+    size_t alloc(size_t size) {
+        size_t block = size;
+        for (auto it = cache.begin(); it != cache.end(); ++it) {
+            if (size <= *it && size > *it/2) {
+                block = *it;
+                cached -= block;
+                cache.erase(it);
+                break;
+            }
+        }
+        live += block;
+        peak  = std::max(peak, committed());
+        return block;
+    }
+
+    void release(size_t block) {
+        live -= block;
+        if (block < limit) {
+            while (cached + block > limit) {
+                cached -= cache.back();
+                cache.pop_back();
+            }
+            cache.push_front(block);
+            cached += block;
+        }
+    }
+};
+
+// the production run of 10-29: a 1355 MiB budget at 262k, a 47,779-token prompt (no re-split) and then a 149,248-token
+// prompt prefilled in batches of 2048 tokens; each batch re-splits when it outgrows the slots (64 pages of headroom).
+// on_resplit(split) is called for the startup split and every re-split; returns the number of re-splits
+template <typename F>
+static int replay_contexts(size_t budget, F on_resplit) {
+    const uint32_t headroom = 64;
+    llama_kv_stream_split cur = llama_kv_stream_split_budget(budget, N_PAGES, headroom, PAGE_POOL, PAGE_RING);
+    on_resplit(cur);
+    int n_resplit = 0;
+    for (uint32_t n_prompt : { 47779u, 149248u }) {
+        for (uint32_t used = 0; used < n_prompt; used += 2048) {
+            const uint32_t n_att = std::min(N_PAGES, pages(std::min(n_prompt, used + 2048)));
+            if (llama_kv_stream_split_outgrown(n_att, cur.n_slots, cur.n_ring)) {
+                cur = llama_kv_stream_split_budget(budget, N_PAGES, std::min(N_PAGES, n_att + headroom), PAGE_POOL, PAGE_RING);
+                CHECK(cur.n_ring > 0 && !llama_kv_stream_split_outgrown(n_att, cur.n_slots, cur.n_ring));
+                on_resplit(cur);
+                n_resplit++;
+            }
+        }
+    }
+    return n_resplit;
+}
+
+int main() {
+    // today's production: a 600 MiB pool, slots outside it for every page that is not resident
+    const size_t prod_pool  = 600*MiB;
+    const uint32_t n_pool   = (uint32_t) (prod_pool/PAGE_POOL);
+    CHECK(n_pool == 92);
+    const size_t prod_slots = (size_t) (N_PAGES - n_pool)*PAGE_RING;
+    CHECK(prod_slots/MiB == 757); // the 757 MiB of kvstream REPORT.md
+    const size_t budget = n_pool*PAGE_POOL + prod_slots;
+
+    // the same VRAM as one budget: nothing streams at short context, the pool takes it all
+    {
+        const llama_kv_stream_split s = llama_kv_stream_split_budget(budget, N_PAGES, pages(8192) + 64, PAGE_POOL, PAGE_RING);
+        CHECK(s.n_ring == 1);
+        CHECK(s.n_slots == (uint32_t) ((budget - PAGE_RING)/PAGE_POOL));
+        CHECK(s.n_slots > 200);
+    }
+
+    // long contexts: the pool shrinks as the ring grows, but never below today's 92 pages (the budget is today's VRAM)
+    uint32_t prev = UINT32_MAX;
+    for (uint32_t n_tokens : { 96*1024u, 143148u, 190974u, 238604u, 262144u }) {
+        const uint32_t n_need = std::min(N_PAGES, pages(n_tokens) + 64);
+        const llama_kv_stream_split s = llama_kv_stream_split_budget(budget, N_PAGES, n_need, PAGE_POOL, PAGE_RING);
+        printf("context %6u: pool %3u pages, ring %3u pages, %.0f of %.0f MiB\n", n_tokens, s.n_slots, s.n_ring,
+                s.bytes(PAGE_POOL, PAGE_RING)/(double) MiB, budget/(double) MiB);
+        CHECK(s.n_slots >= n_pool);
+        CHECK(s.n_slots <= prev);
+        CHECK(s.n_slots + s.n_ring == n_need);
+        prev = s.n_slots;
+        check_split(budget, n_need);
+    }
+    // at the full context the split is today's (both hold every page)
+    {
+        const llama_kv_stream_split s = llama_kv_stream_split_budget(budget, N_PAGES, N_PAGES, PAGE_POOL, PAGE_RING);
+        CHECK(s.n_slots == n_pool);
+        CHECK(s.n_ring == N_PAGES - n_pool);
+    }
+
+    // a budget that cannot even hold the ring
+    {
+        const llama_kv_stream_split s = llama_kv_stream_split_budget((size_t) 500*PAGE_RING, N_PAGES, 600, PAGE_POOL, PAGE_RING);
+        CHECK(s.n_slots == 0 && s.n_ring == 0);
+    }
+    // degenerate inputs
+    CHECK(llama_kv_stream_split_budget(budget, N_PAGES, 0, PAGE_POOL, PAGE_RING).n_slots == 0);
+    CHECK(llama_kv_stream_split_budget(budget, N_PAGES, 10, PAGE_RING, PAGE_RING).n_slots == 0);
+    // a budget larger than the whole context: the pool is capped at the context's pages
+    {
+        const llama_kv_stream_split s = llama_kv_stream_split_budget((size_t) 8000*MiB, N_PAGES, 100, PAGE_POOL, PAGE_RING);
+        CHECK(s.n_slots == N_PAGES && s.n_ring == 1);
+    }
+
+    // exhaustive over the needs and a range of budgets
+    for (size_t b = 64*MiB; b <= 3000*MiB; b += 37*MiB) {
+        for (uint32_t n_need = 1; n_need <= N_PAGES; n_need += 7) {
+            check_split(b, n_need);
+        }
+    }
+
+    // re-split only when the attended pages pass the pool and the ring together
+    CHECK(!llama_kv_stream_split_outgrown(208, 208, 1));
+    CHECK(!llama_kv_stream_split_outgrown(209, 208, 1));
+    CHECK( llama_kv_stream_split_outgrown(210, 208, 1));
+    CHECK(!llama_kv_stream_split_outgrown(0,   150, 0));
+
+    // the invariant behind it, simulated with prepare()'s placement: pages become resident only below each ubatch's
+    // n_att, a cut sequence leaves stale pages, and what streams never exceeds the ring while n_att stays within
+    // pool + ring
+    {
+        const uint32_t n_slots = 40;
+        const uint32_t n_ring  = 25;
+        std::vector<int> resident(N_PAGES, 0);
+        uint32_t n_res = 0;
+        // a ubatch that attends [0, n_att) and writes its last page
+        auto prepare = [&](uint32_t n_att) {
+            CHECK(!llama_kv_stream_split_outgrown(n_att, n_slots, n_ring));
+            if (!resident[n_att - 1]) {
+                if (n_res == n_slots) {
+                    // the victim: the lowest resident page that is not written
+                    uint32_t v = 0;
+                    while (!resident[v] || v == n_att - 1) {
+                        v++;
+                    }
+                    resident[v] = 0;
+                    n_res--;
+                }
+                resident[n_att - 1] = 1;
+                n_res++;
+            }
+            // free slots take the newest attended pages
+            for (uint32_t p = n_att; p-- > 0 && n_res < n_slots; ) {
+                if (!resident[p]) {
+                    resident[p] = 1;
+                    n_res++;
+                }
+            }
+            uint32_t streamed = 0;
+            for (uint32_t p = 0; p < n_att; ++p) {
+                streamed += !resident[p];
+            }
+            CHECK(streamed <= n_ring);
+        };
+        for (uint32_t n = 1; n <= n_slots + n_ring; ++n) {
+            prepare(n); // a context growing to pool + ring
+        }
+        for (uint32_t cut : { 50u, 20u, 5u, 64u }) {
+            for (uint32_t n = cut; n <= n_slots + n_ring; ++n) {
+                prepare(n); // the sequence cut to `cut` pages, then growing again over its stale pages
+            }
+        }
+    }
+
+    // the arena allocated for a budget holds every split of it
+    for (size_t b : { 200*MiB, 600*MiB, 1355*MiB, 1718*MiB, 3000*MiB, 8000*MiB }) {
+        for (size_t align : { (size_t) 1, (size_t) 128, (size_t) 4096 }) {
+            check_arena(b, align, 0);
+            check_arena(b, align, 1088*8); // e.g. the allocator pads quantized rows
+        }
+    }
+    // ... and its chunked regions (LLAMA_KV_STREAM_POOL_CHUNK_MIB): 1024 MiB holds the slots of a whole layer (832 MiB),
+    // 256 MiB does not, 64 MiB is below two of the largest tensors
+    for (size_t b : { 600*MiB, 1355*MiB, 1600*MiB, 2400*MiB, 3000*MiB, 8000*MiB }) {
+        for (size_t chunk : { 1024*MiB, 256*MiB, 64*MiB }) {
+            for (size_t align : { (size_t) 128, (size_t) 4096 }) {
+                check_chunked_arena(b, align, 0, chunk);
+                check_chunked_arena(b, align, 1088*8, chunk);
+            }
+        }
+    }
+    {
+        // the slack at 2400 MiB with 1024 MiB chunks: a pool tensor per boundary (369 pages of one layer's K: 98 MiB)
+        const std::vector<size_t> r = llama_kv_stream_arena_regions(2400*MiB, 1024*MiB, 98*MiB, 128);
+        CHECK(r.size() == 3 && r[0] == 1024*MiB && r[1] == 1024*MiB && r[2] == 548*MiB);
+        CHECK(llama_kv_stream_arena_regions(1000*MiB, 1024*MiB, 98*MiB, 128).size() == 1);
+        CHECK(llama_kv_stream_arena_regions(3000*MiB, 0, 0, 128).size() == 1);
+    }
+
+    CHECK( llama_kv_stream_split_keeps_arena(1355*MiB, 1355*MiB));
+    CHECK(!llama_kv_stream_split_keeps_arena(1355*MiB, 1400*MiB));
+    CHECK(!llama_kv_stream_split_keeps_arena(0, 0));
+
+    // The VRAM overshoot measured on 10-29 (14.41 GB dedicated vs 13.58 GB for the unsplit layout under the same 1355 MiB,
+    // then a spill into shared memory during a 149k-token prompt), replayed under the PAL resource cache: freeing and
+    // reallocating the pool and the slots leaves every slot buffer the slots outgrew committed. One arena per budget,
+    // kept by the re-splits, stays at the budget throughout.
+    {
+        const size_t vram   = 16304*MiB; // RX 9070 XT
+        const size_t budget = 1355*MiB;
+
+        // the unsplit production layout: a 600 MiB pool, slots for the other 932 pages (the stream allocates slots of a
+        // whole layer, which set_backend shrinks: the cache hands the freed block back for the smaller request)
+        pal_allocator base_a(vram/8);
+        {
+            base_a.alloc(92*PAGE_POOL);
+            const size_t r = base_a.alloc((size_t) N_PAGES*PAGE_RING);
+            base_a.release(r);
+            base_a.alloc((size_t) (N_PAGES - 92)*PAGE_RING);
+        }
+
+        // the split before the arena: the cache allocates a pool of the whole budget and the stream slots of a layer,
+        // shrunk by set_backend; the startup split and every re-split free the slots, then the pool (release_pool, then
+        // the cache's buffers), and allocate the new pool and slots
+        pal_allocator old_a(vram/8);
+        size_t pool = 0;
+        size_t ring = 0;
+        size_t after_startup = 0;
+        int    n_calls = 0;
+        const int n_old = replay_contexts(budget, [&](const llama_kv_stream_split & s) {
+            if (n_calls++ == 0) {
+                const uint32_t n_first = (uint32_t) (budget/PAGE_POOL);
+                pool = old_a.alloc((size_t) n_first*PAGE_POOL);
+                ring = old_a.alloc((size_t) N_PAGES*PAGE_RING);
+                old_a.release(ring);
+                ring = old_a.alloc((size_t) (N_PAGES - n_first)*PAGE_RING);
+            }
+            old_a.release(ring);
+            old_a.release(pool);
+            pool = old_a.alloc((size_t) s.n_slots*PAGE_POOL);
+            ring = old_a.alloc((size_t) s.n_ring*PAGE_RING);
+            if (n_calls == 1) {
+                after_startup = old_a.committed();
+            }
+        });
+        printf("PAL cache model, 1355 MiB budget: unsplit %.0f MiB; split before the arena %.0f MiB after startup, "
+                "%.0f MiB at the peak (%d re-splits)\n", base_a.committed()/(double) MiB, after_startup/(double) MiB,
+                old_a.peak/(double) MiB, n_old);
+        // what was measured: 0.83 GB more dedicated and 0.28 GB more shared memory than the unsplit layout over the run.
+        // In the model the startup leaves the budget (its ~2.1 GiB peak is gone once the 1352 MiB pool pushes the
+        // layer-sized slot block out of the cache), and the re-splits of the 149k prompt each leave the old slots behind
+        CHECK(after_startup <= budget);
+        CHECK(old_a.peak > budget + 900*MiB);
+        CHECK(old_a.peak > base_a.committed() + 800*MiB);
+        CHECK(n_old == 6);
+
+        // the arena: allocated once for the budget, kept by every re-split under it
+        pal_allocator new_a(vram/8);
+        const size_t arena = llama_kv_stream_split_arena_size(budget, 36, 0, 128);
+        size_t arena_budget = 0;
+        size_t block = 0;
+        const int n_new = replay_contexts(budget, [&](const llama_kv_stream_split & s) {
+            CHECK(llama_kv_stream_split_placed(s, POOL_T, 32, RING_T, 4, 0, 128) <= arena);
+            if (!llama_kv_stream_split_keeps_arena(arena_budget, budget)) {
+                if (block) {
+                    new_a.release(block);
+                }
+                block = new_a.alloc(arena);
+                arena_budget = budget;
+            }
+            CHECK(new_a.committed() == arena);
+        });
+        printf("PAL cache model, 1355 MiB budget: the arena %.2f MiB, at the peak %.2f MiB\n", arena/(double) MiB,
+                new_a.peak/(double) MiB);
+        CHECK(n_new == n_old);
+        CHECK(new_a.peak == arena);
+        CHECK(arena - budget < MiB);
+    }
+
+    printf("%s: OK\n", __FILE__);
+    return 0;
+}
