+    if (split) {
+        LLAMA_LOG_INFO("%s: KV stream split: pool %u -> %u pages, slots %u -> %u pages, for %u attended pages (%u stale) "
+                "in a %zu MiB budget (%s) in %.1f ms%s\n", __func__, pool_from, kv_stream->n_pool(), ring_from,
+                kv_stream->n_ring(), n_att, n_stale, kv_budget >> 20, why_split ? why_split : "budget changed",
+                (ggml_time_us() - t0)/1000.0, idle ? " [idle]" : "");
+    }
+    if (kv_pool_ctl && (!split || d.size > 0 || fallback || from != kv_pool_size)) {
+        const char * why = "retry";
+        switch (d.why) {
+            case llama_kv_pool_ctl::GROW:           why = "grow";                    break;
+            case llama_kv_pool_ctl::SHRINK_BUDGET:  why = "shrink, low free memory"; break;
+            case llama_kv_pool_ctl::SHRINK_DEMOTED: why = "shrink, demoted memory";  break;
+            default: break;
+        }
+        LLAMA_LOG_INFO("%s: KV pool %zu -> %zu MiB (%s%s: %.0f MiB free, %.0f demoted; budget %.0f, usage %.0f; adapter %.0f "
+                "of %.0f resident) in %.1f ms%s\n", __func__, from >> 20, kv_pool_size >> 20, why,
+                fallback ? ", fell back to the minimum after the error above" : "", d.headroom/MiB, d.demoted/MiB,
+                s.budget/MiB, s.usage/MiB, s.adapter_resident/MiB, s.adapter_total/MiB, (ggml_time_us() - t0)/1000.0,
+                idle ? " [idle]" : "");
+    }
