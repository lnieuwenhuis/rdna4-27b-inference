+#include <chrono>
 #include <cinttypes>
 #include <cstdarg>
 #include <cstdint>
@@ -9483,6 +9485,86 @@ struct test_flash_attn_ext_paged : public test_case {
     }
 };
 
+// test_flash_attn_ext_paged with K/V written by another queue (ggml_flash_attn_ext_set_sync, as KV streaming sets it,
+// with the host copy of the tag). The ready flag already holds the tag (sync=1), or a thread publishes it 100 ms after
+// the inputs are set (sync=2; it aborts if the op released the K/V before that), so the result must match whether the
+// backend waits on the host or in the kernels (CUDA/HIP: LLAMA_KV_STREAM_EVENT_WAIT=0/1, and
+// LLAMA_KV_STREAM_WAIT_KERNEL=0/1 for the kernels). The flags are in the backend's copy engine memory when it has one
+// (device kernels poll it), else in host memory.
+struct test_flash_attn_ext_paged_sync : public test_flash_attn_ext_paged {
+    static constexpr int32_t tag_value = 7;
+
+    const ggml_backend_copy_engine_i * ce_iface = nullptr;
+    ggml_backend_copy_engine_t         ce       = nullptr;
+    uint32_t *                         flags    = nullptr; // ready, consumed, host copy of the tag
+    uint32_t                           host_flags[3] = {};
+
+    bool        late = false; // publish after the inputs are set
+    std::thread publisher;
+
+    using test_flash_attn_ext_paged::test_flash_attn_ext_paged;
+
+    ~test_flash_attn_ext_paged_sync() override {
+        if (publisher.joinable()) {
+            publisher.join();
+        }
+        if (ce) {
+            ce_iface->free(ce);
+        }
+    }
+
+    std::string vars() override {
+        return test_flash_attn_ext_paged::vars() + (late ? ",sync=2" : ",sync=1");
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * out = test_flash_attn_ext_paged::build_graph(ctx);
+        ggml_tensor * tag = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+        ggml_set_name(tag, "tag");
+        // the flags of the backend are known once the tensors are allocated (initialize_tensors)
+        ggml_flash_attn_ext_set_sync(out, tag, host_flags, host_flags + 1);
+        ggml_flash_attn_ext_set_sync_host_tag(out, host_flags + 2);
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_flash_attn_ext_paged::initialize_tensors(ctx);
+
+        ggml_tensor * tag = ggml_get_tensor(ctx, "tag");
+        ggml_tensor * out = ggml_get_tensor(ctx, "out");
+        ggml_backend_tensor_set(tag, &tag_value, 0, sizeof(tag_value));
+
+        if (!flags) {
+            flags = host_flags;
+            ggml_backend_dev_t dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(tag->buffer));
+            ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+            auto get_iface = reg ? (ggml_backend_copy_engine_get_iface_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_copy_engine") : nullptr;
+            if (get_iface) {
+                ce_iface = get_iface();
+                ce       = ce_iface->init(dev, 1);
+                flags    = (uint32_t *) ce_iface->alloc_shared(ce, 3*sizeof(uint32_t));
+            }
+        }
+        if (publisher.joinable()) {
+            publisher.join();
+        }
+        flags[0] = late ? tag_value - 1 : tag_value; // published unless late
+        flags[1] = 0;
+        flags[2] = tag_value;
+        ggml_flash_attn_ext_set_sync(out, tag, flags, flags + 1);
+        ggml_flash_attn_ext_set_sync_host_tag(out, flags + 2);
+        if (late) {
+            publisher = std::thread([this]() {
+                std::this_thread::sleep_for(std::chrono::milliseconds(100));
+                if (__atomic_load_n(flags + 1, __ATOMIC_ACQUIRE) != 0) {
+                    GGML_ABORT("%s: the K/V were released before they were published", vars().c_str());
+                }
+                __atomic_store_n(flags, (uint32_t) tag_value, __ATOMIC_RELEASE);
+            });
+        }
+    }
+};
