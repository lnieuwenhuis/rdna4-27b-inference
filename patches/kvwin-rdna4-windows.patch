+void common_checkpoint_buffers::put(std::vector<uint8_t> && buf) {
+    if (buf.capacity() == 0 || n_max == 0) {
+        return;
+    }
+    auto pos = std::find_if(bufs.begin(), bufs.end(), [&](const std::vector<uint8_t> & b) {
+        return b.capacity() < buf.capacity();
+    });
+    bufs.insert(pos, std::move(buf));
+    if (bufs.size() > n_max) {
+        bufs.resize(n_max); // frees the smallest
+    }
+}
+
+std::vector<uint8_t> common_checkpoint_buffers::take() {
+    std::vector<uint8_t> res;
+    if (!bufs.empty()) {
+        res = std::move(bufs.front());
+        bufs.erase(bufs.begin());
+    }
+    return res;
+}
+
+size_t common_checkpoint_buffers::bytes() const {
+    size_t res = 0;
+    for (const auto & b : bufs) {
+        res += b.capacity();
+    }
+    return res;
+}
+
 size_t common_prompt_checkpoint::size() const {
