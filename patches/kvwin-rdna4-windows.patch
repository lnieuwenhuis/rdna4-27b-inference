+bool llama_context::adapt_kv_pool(bool idle, uint32_t n_tokens) {
+    const bool split = cparams.kv_stream_split > 0;
+    if ((!kv_pool_ctl && !split) || !memory) {
+        return true;
+    }
+    const llama_kv_stream * kv_stream = memory->get_kv_stream();
+    if (!kv_stream) {
+        return true;
+    }
+    // a split under a fixed budget only follows the context, which does not change between batches
+    if (!kv_pool_ctl && idle) {
+        return true;
+    }
+
+    const double  MiB = 1024.0*1024.0;
+    const int64_t now = ggml_time_us();
+
+    llama_vram_snapshot           s;
+    llama_kv_pool_ctl::decision d;
+    if (kv_pool_ctl) {
+        // a caller that ticks while idle (the server) gets the grows there: a resize writes the pool back and
+        // re-streams it, which would stall a running request; shrinks happen wherever they are needed
+        kv_pool_idle_seen = kv_pool_idle_seen || idle;
+        const bool allow_grow = idle || !kv_pool_idle_seen;
+
+        s = kv_vram->latest();
+        d = kv_pool_ctl->decide(s, kv_pool_size, now, allow_grow);
+
+        if (kv_pool_trace && s.valid && s.t_us != kv_pool_t_trace) {
+            kv_pool_t_trace = s.t_us;
+            LLAMA_LOG_INFO("%s: pool %zu MiB, free %.0f MiB (budget %.0f, usage %.0f, non-local %.0f, demoted %.0f; adapter "
+                    "%.0f of %.0f resident)%s\n", __func__, kv_pool_size >> 20, d.headroom/MiB, s.budget/MiB, s.usage/MiB,
+                    s.usage_nonlocal/MiB, d.demoted/MiB, s.adapter_resident/MiB, s.adapter_total/MiB, idle ? " [idle]" : "");
+        }
+
+        if (d.why == llama_kv_pool_ctl::AT_MIN && now - kv_pool_t_at_min > 30*1000*1000) {
+            kv_pool_t_at_min = now;
