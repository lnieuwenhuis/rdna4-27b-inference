+std::vector<size_t> llama_kv_cache::split_arena_regions(ggml_backend_buffer_type_t buft, size_t budget) const {
+    // the allocator's bytes past the data of every tensor a split places (row padding, the same for any number of
+    // rows): K and V of every layer in the pool, and K and V of both slots, whose rows are layer 0's
