+    // the context counts the arena as the budget's device bytes (the adaptive pool, the re-split checks), and chunks add
+    // up to a pool tensor per region boundary: the arena is chunked only when LLAMA_KV_STREAM_POOL_CHUNK_MIB asks for it
+    const size_t chunk = getenv("LLAMA_KV_STREAM_POOL_CHUNK_MIB") ? llama_kv_stream::pool_chunk_size(buft) : 0;
+    if (chunk == 0 || size <= chunk) {
+        return llama_kv_stream_arena_regions(size, 0, 0, align);
+    }
