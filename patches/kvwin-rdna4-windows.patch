+private:
+    common_spec_switch_choice probe(common_spec_switch_seq & seq, int32_t a, common_spec_switch_event event) {
+        auto & arm = seq.arms()[a];
+        seq.probe_arm     = a;
+        seq.probe_done    = 1;
+        seq.n_since_probe = 0;
+        arm.n_probes++;
+        arm.n_chosen++;
+        return { a, event };
+    }
+
+    void switch_to(common_spec_switch_seq & seq, int32_t a) {
+        seq.active      = a;
+        seq.n_on_active = 0;
+        seq.probe_arm   = -1;
+        seq.probe_done  = 0;
+        seq.backoff     = 1;
+        seq.n_switches++;
+    }
