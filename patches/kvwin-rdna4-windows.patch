diff --git a/src/llama-kv-pool-ctl.h b/src/llama-kv-pool-ctl.h
new file mode 100644
index 0000000..95cff48
--- /dev/null
+++ b/src/llama-kv-pool-ctl.h
@@ -0,0 +1,208 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+// Adaptive KV stream pool [EXPERIMENTAL] (--kv-resident-mib auto): the policy that sizes the resident pool from the
+// free device memory. Pure logic, so it is tested without a GPU (tests/test-kv-pool-ctl.cpp); llama_context feeds it
+// snapshots of llama_vram_monitor and applies its decisions with llama_memory_i::resize_kv_stream.
+//
+// Windows (WDDM) does not fail an allocation when the processes on a GPU want more than its memory: it demotes
+// allocations to shared system memory, and decode then runs at about half speed. The policy keeps `margin` bytes of
+// local memory free:
+//   - it shrinks the pool at once when the free memory drops below the margin, by the deficit plus half the
+//     hysteresis, down to min_size;
+//   - it grows the pool by at most grow_step when the free memory has stayed above margin + grow_hyst for
+//     grow_delay_us, and not within cooldown_us of the last shrink;
+//   - a shrink within unstable_us of a grow doubles the cooldown (once per grow, up to cooldown_max_us), so a budget
+//     that keeps changing does not rebuild the pool every minute; a grow stable_us after the last shrink resets it;
+//   - the caller may hold grows back while a request runs (every resize writes the pool back and re-streams it).
+// Every resize is reported back with on_resized(), with the size the pool actually got.
+// Demotions that already happened are counted as missing headroom: the bytes by which this process's non-local usage
+// grew while its local usage fell by about as much (or while the pool was being resized). Non-local growth without a
+// local drop is taken as a legitimate host allocation (pinned staging buffers) and moves the baseline.
+
+// what the OS reports for this process on the pool's device
+struct llama_vram_snapshot {
+    bool    valid = false;
+    int64_t t_us  = 0;
+
+    // this process, local segment group (QueryVideoMemoryInfo); budget 0 = unknown
+    uint64_t budget         = 0;
+    uint64_t usage          = 0;
+    uint64_t usage_nonlocal = 0; // pinned host memory, and whatever was demoted to system memory
+
+    // the adapter's local memory segments, all processes; total 0 = unknown
+    uint64_t adapter_total    = 0;
+    uint64_t adapter_resident = 0;
+
+    // free local memory for this process: the smaller of what its budget and the adapter have left (can be negative)
+    int64_t headroom() const {
+        int64_t h = INT64_MAX;
+        if (budget > 0) {
+            h = std::min(h, (int64_t) budget - (int64_t) usage);
+        }
+        if (adapter_total > 0) {
+            h = std::min(h, (int64_t) adapter_total - (int64_t) adapter_resident);
+        }
+        return h;
+    }
+};
+
+struct llama_kv_pool_policy {
+    size_t  min_size        = 0;             // pool bytes
+    size_t  max_size        = 0;             // the caller caps it at the pool that holds the whole context
+    size_t  margin          = 512ull << 20;  // free local memory to keep
+    size_t  grow_hyst       = 256ull << 20;  // grow only above margin + grow_hyst
+    size_t  grow_step       = 256ull << 20;  // largest grow
+    size_t  min_change      = 32ull  << 20;  // smaller resizes are not worth a pool rebuild
+    size_t  demote_min      = 8ull   << 20;  // non-local growth per snapshot that is looked at as a possible demotion
+    double  net_fraction    = 1.0;           // device memory a pool byte frees (the streaming slots grow as the pool shrinks)
+    int64_t grow_delay_us   = 5000000;
+    int64_t cooldown_us     = 30000000;
+    int64_t cooldown_max_us = 900000000;
+    int64_t unstable_us     = 60000000;      // a shrink this soon after a grow doubles the cooldown (once per grow)
+    int64_t stable_us       = 600000000;     // a grow this long after the last shrink resets the cooldown
+    int64_t settle_us       = 500000;        // snapshots taken this soon after a resize may not show it yet
+};
+
+class llama_kv_pool_ctl {
+public:
+    enum reason {
+        KEEP,
+        GROW,
+        SHRINK_BUDGET,  // free memory below the margin
+        SHRINK_DEMOTED, // allocations of this process were demoted to system memory
+        AT_MIN,         // below the margin, but the pool is at min_size already
+    };
+
+    struct decision {
+        size_t   size     = 0; // the pool size to resize to, 0 = keep
+        reason   why      = KEEP;
+        int64_t  headroom = 0; // free local memory, less the demoted bytes
+        uint64_t demoted  = 0; // demoted bytes not back yet
+    };
+
+    explicit llama_kv_pool_ctl(const llama_kv_pool_policy & p) : p(p), cooldown(p.cooldown_us) {}
+
+    const llama_kv_pool_policy & policy() const { return p; }
+    int64_t cooldown_cur() const { return cooldown; }
+
+    // cur: the pool size in use; allow_grow: false when a grow would stall a running request (the caller grows from
+    // its idle ticks instead). Call with every new snapshot, or more often.
+    decision decide(const llama_vram_snapshot & s, size_t cur, int64_t now_us, bool allow_grow = true) {
+        decision d;
+        if (!s.valid) {
+            return d;
+        }
+
+        // a snapshot taken during a resize says nothing reliable about it: keep comparing against the one before
+        const bool straddles = last_resize_us != 0 && s.t_us < last_resize_us;
+        if (s.t_us != prev.t_us && !straddles) {
+            track_demotions(s, cur);
+        }
+        d.demoted  = s.usage_nonlocal > nonlocal_base ? s.usage_nonlocal - nonlocal_base : 0;
+        d.headroom = s.headroom() - (int64_t) d.demoted;
+
+        // the snapshot may predate the last resize or not show it yet (the monitor refreshes every few hundred ms,
+        // decode runs more often): acting on it would shrink twice for one deficit
+        if (last_resize_us != 0 && s.t_us < last_resize_us + p.settle_us) {
+            return d;
+        }
+
+        const int64_t margin = (int64_t) p.margin;
+
+        if (d.headroom < margin) {
+            ok_since = 0;
+            // shrinking the pool by X frees about X*net_fraction
+            const size_t deficit = (size_t) (margin - d.headroom) + p.grow_hyst/2;
+            const size_t want    = (size_t) ((double) deficit/std::max(p.net_fraction, 0.1));
+            const size_t target  = std::max(p.min_size, cur > want ? cur - want : (size_t) 0);
+            if (target >= cur) {
+                d.why = AT_MIN;
+                return d;
+            }
+            d.size = target;
+            d.why  = d.demoted > 0 ? SHRINK_DEMOTED : SHRINK_BUDGET;
+            return d;
+        }
+
+        if (d.headroom < margin + (int64_t) p.grow_hyst || cur >= p.max_size) {
+            ok_since = 0;
+            return d;
+        }
+        if (ok_since == 0) {
+            ok_since = now_us;
+        }
+        if (!allow_grow || now_us - ok_since < p.grow_delay_us ||
+            (last_shrink_us != 0 && now_us - last_shrink_us < cooldown)) {
+            return d;
+        }
+        // keep half the hysteresis free after the grow, so that the next snapshot does not shrink it again
+        // never below min_size: a pool that could not be allocated at all (cur 0) comes back at its minimum at least
+        const size_t room   = (size_t) (d.headroom - margin) - p.grow_hyst/2;
+        const size_t target = std::max(p.min_size, std::min(p.max_size, cur + std::min(p.grow_step, room)));
+        if (target - cur < p.min_change && target < p.max_size) {
+            return d;
+        }
+        d.size = target;
+        d.why  = GROW;
+        return d;
+    }
+
+    // after the caller resized the pool from `from` to `to` bytes (what it got, which may differ from the decision);
+    // now_us: when the resize finished
+    void on_resized(int64_t now_us, size_t from, size_t to) {
+        resized        = true;
+        last_resize_us = now_us;
+        ok_since       = 0;
+        if (to > from) {
+            if (last_shrink_us == 0 || now_us - last_shrink_us >= p.stable_us) {
+                cooldown = p.cooldown_us;
+            }
+            last_grow_us   = now_us;
+            doubled_since_grow = false;
+        } else if (to < from) {
+            if (last_grow_us != 0 && now_us - last_grow_us < p.unstable_us && !doubled_since_grow) {
+                cooldown = std::min(2*cooldown, p.cooldown_max_us);
+                doubled_since_grow = true;
+            }
+            last_shrink_us = now_us;
+        }
+    }
+
+private:
+    void track_demotions(const llama_vram_snapshot & s, size_t cur) {
+        if (!prev.valid) {
+            nonlocal_base = s.usage_nonlocal;
+        } else if (s.usage_nonlocal < prev.usage_nonlocal) {
+            // demoted memory came back, or host memory was freed
+            nonlocal_base = std::min(nonlocal_base, s.usage_nonlocal);
+        } else {
+            const uint64_t grew = s.usage_nonlocal - prev.usage_nonlocal;
+            const uint64_t fell = prev.usage > s.usage ? prev.usage - s.usage : 0;
+            // the pool is device memory: across a resize, non-local growth can only be a demotion
+            const bool demotion = grew >= p.demote_min && (resized || prev_cur != cur || fell >= grew/2);
+            if (!demotion) {
+                nonlocal_base += grew;
+            }
+        }
+        prev     = s;
+        prev_cur = cur;
+        resized  = false;
+    }
+
+    const llama_kv_pool_policy p;
+
+    llama_vram_snapshot prev;
+    size_t   prev_cur           = 0;
+    bool     resized            = false;
+    bool     doubled_since_grow = false;
+    uint64_t nonlocal_base      = 0;
+    int64_t  ok_since           = 0;
+    int64_t  last_grow_us       = 0;
+    int64_t  last_shrink_us     = 0;
+    int64_t  last_resize_us     = 0;
+    int64_t  cooldown;
+};
diff --git a/src/llama-kv-stream-place.h b/src/llama-kv-stream-place.h
new file mode 100644
index 0000000..1fff56a
--- /dev/null
+++ b/src/llama-kv-stream-place.h
@@ -0,0 +1,150 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+// KV streaming: which pages hold the pool slots before a ubatch (llama_kv_stream::prepare). Pure placement over the
+// page table, so it is tested without a GPU (tests/test-kv-stream-place.cpp).
+//
+// The pages the ubatch writes are made resident first; without a free slot, one takes the slot of the oldest other
+// resident page, which is evicted (written back if it changed). Free slots then take the newest attended pages, which
+// would stream otherwise.
+//
+// Stale pages: cutting a sequence (memory_seq_rm), restoring a state (the server's prompt cache) or a context checkpoint
+// empties the cells past the used ones without moving any page, so the pages of a longer context stay resident past the
+// n_att pages the next ubatches attend while attended pages stream. No ubatch reads their cells before it writes them
+// again: n_kv (llama_kv_cache::get_n_kv) covers every used cell, so the cells of a page at or past n_att are all empty.
+// With LLAMA_KV_STREAM_RERESIDE their slots go first (past a page of margin, lowest slot first): to the written pages
+// before any attended page is evicted, then to the newest attended pages that would stream. They are dropped, not
+// written back, since their data is dead. This only changes where pages live, not what the attention reads; but the
+// paged prefill attends each run of consecutive pool or ring pages as a part and merges the parts (fattn-paged-decode.cu),
+// so the rounding of a prefill ubatch depends on where the pages live, as it does on the pool size. The decode kernel
+// does not depend on it.
+//
+// When it pays: a page that becomes resident costs one read-back and saves its copy in every later ubatch that attends
+// it, so while pages keep streaming the re-plan pays within a few decode steps (10-30: 0.11-0.13 ms less per decode step
+// for each page that no longer streams, at equal draft lengths). When the attended pages fit the pool, the re-plan leaves
+// nothing streaming instead, and that was slower: agent turns of 9-13k tokens after a 143k request decoded 1.6-4.1 ms per
+// step (3-8 %) slower with no page streaming than with the 35-50 pages the stale tail left streaming, at identical tokens.
+// Why is not known (an unverified hypothesis: a graph whose attention streams nothing has no host wait, so it takes the
+// HIP graph path and the batched submission instead). So with LLAMA_KV_STREAM_RERESIDE=1 the stale pages give their
+// slots up only while the attended pages do not fit the pool (n_att > n_slots): the re-plan never takes a ubatch from
+// streaming pages to streaming none, and when they fit, the moves are exactly those without it.
+enum llama_kv_stream_rereside : int32_t {
+    LLAMA_KV_STREAM_RERESIDE_OFF    = 0, // stale pages stay resident until they are evicted as the oldest
+    LLAMA_KV_STREAM_RERESIDE_UNFIT  = 1, // they give their slots up while the attended pages do not fit the pool
+    LLAMA_KV_STREAM_RERESIDE_ALWAYS = 2, // also when they fit (the first version, slower on agent turns; for A/B tests)
+};
+
+// pages just past the attended ones that are not stale yet (a speculative draft may write them again at once)
+static constexpr uint32_t llama_kv_stream_stale_margin = 1;
+
+// page_slot [n_pages] / slot_page [n_slots]: the page table, which the callbacks update as they move pages:
+//   evict(page)        page leaves its slot (written back if dirty)
+//   drop(page)         page leaves its slot without a write-back (a stale page)
+//   assign(page, slot) page takes the free slot (read back if the host store holds it)
+template <typename Evict, typename Drop, typename Assign>
+static void llama_kv_stream_place(const std::vector<int32_t> & page_slot, const std::vector<int32_t> & slot_page,
+        const std::vector<uint8_t> & written, uint32_t n_att, llama_kv_stream_rereside mode, Evict && evict, Drop && drop,
+        Assign && assign) {
+    const uint32_t n_pages = (uint32_t) page_slot.size();
+    const uint32_t n_slots = (uint32_t) slot_page.size();
+
+    const bool rereside = mode == LLAMA_KV_STREAM_RERESIDE_ALWAYS ||
+        (mode == LLAMA_KV_STREAM_RERESIDE_UNFIT && n_att > n_slots);
+
+    uint32_t free_slot = 0;
+    auto next_free = [&]() {
+        while (free_slot < n_slots && slot_page[free_slot] >= 0) {
+            free_slot++;
+        }
+        return free_slot;
+    };
+
+    // the stale pages, past a page of margin (a draft rejected across a page boundary must not drop the page the next
+    // draft writes again). The one in the lowest slot goes first: pages placed in ascending order then take ascending
+    // slots, so consecutive pages stay one run of the paged prefill (a part and a merge per run, fattn-paged-decode.cu).
+    // Taking the furthest page first would spare the read-backs of pages the context writes next, but it hands the
+    // slots out in descending order: a prefill after a shrink then attends ~100 runs instead of 2-5
+    std::vector<uint32_t> stale;
+    if (rereside) {
+        for (uint32_t p = n_att + llama_kv_stream_stale_margin; p < n_pages; ++p) {
+            if (page_slot[p] >= 0 && !written[p]) {
+                stale.push_back(p);
+            }
+        }
+        std::sort(stale.begin(), stale.end(), [&](uint32_t a, uint32_t b) { return page_slot[a] > page_slot[b]; });
+    }
+    auto take_stale = [&]() {
+        const uint32_t p    = stale.back();
+        const uint32_t slot = (uint32_t) page_slot[p];
+        stale.pop_back();
+        drop(p);
+        return slot;
+    };
+
+    // the written pages are resident: a stale slot, or evict the oldest other page if there is no free slot
+    for (uint32_t p = 0; p < n_pages; ++p) {
+        if (!written[p] || page_slot[p] >= 0) {
+            continue;
+        }
+        uint32_t slot = next_free();
+        if (slot == n_slots) {
+            if (!stale.empty()) {
+                slot = take_stale();
+            } else {
+                uint32_t victim = 0;
+                while (victim < n_pages && (page_slot[victim] < 0 || written[victim])) {
+                    victim++;
+                }
+                if (victim == n_pages) {
+                    // the pool is smaller than a ubatch: the caller asserts that every written page is resident
+                    return;
+                }
+                slot = (uint32_t) page_slot[victim];
+                evict(victim);
+            }
+        }
+        assign(p, slot);
+    }
+
+    // free slots take the newest attended pages
+    if (!rereside) {
+        for (uint32_t p = n_att; p-- > 0; ) {
+            if (page_slot[p] >= 0) {
+                continue;
+            }
+            const uint32_t slot = next_free();
+            if (slot == n_slots) {
+                break;
+            }
+            assign(p, slot);
+        }
+        return;
+    }
+
+    // ... then stale ones; the pages go into the slots in the same order, so that consecutive pages stay one run
+    std::vector<uint32_t> pages;
+    std::vector<uint32_t> slots;
+    for (uint32_t p = n_att; p-- > 0; ) {
+        if (page_slot[p] >= 0) {
+            continue;
+        }
+        uint32_t slot = next_free();
+        if (slot < n_slots) {
+            free_slot++; // taken below; a dropped slot is never seen here, the free ones run out first
+        } else if (!stale.empty()) {
+            slot = take_stale();
+        } else {
+            break;
+        }
+        pages.push_back(p);
+        slots.push_back(slot);
+    }
+    std::reverse(pages.begin(), pages.end());
+    std::sort(slots.begin(), slots.end());
+    for (size_t i = 0; i < pages.size(); ++i) {
+        assign(pages[i], slots[i]);
+    }
+}
diff --git a/src/llama-kv-stream-split.h b/src/llama-kv-stream-split.h
new file mode 100644
index 0000000..0aabce4
--- /dev/null
+++ b/src/llama-kv-stream-split.h
@@ -0,0 +1,125 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// KV streaming: how one device budget is split between the pool of resident pages and the two streaming slots
+// (llama_kv_stream). Pure arithmetic, so it is tested without a GPU (tests/test-kv-stream-split.cpp).
+//
+// When prefill and decode both attend the pages through the page table (llama_kv_stream::ring_packed), a slot only
+// holds the pages that stream, packed. If n_need pages are attended, P of them are resident and n_need - P stream, so
+// the budget has to hold P pool pages (page_pool bytes each: K and V of every layer) and n_need - P ring pages
+// (page_ring bytes each: K and V of one layer, in both slots).
+
+struct llama_kv_stream_split {
+    uint32_t n_slots = 0; // pool pages; 0 = the budget cannot hold the ring for n_need pages
+    uint32_t n_ring  = 0; // pages per streaming slot
+
+    // device bytes the split takes
+    size_t bytes(size_t page_pool, size_t page_ring) const {
+        return (size_t) n_slots*page_pool + (size_t) n_ring*page_ring;
+    }
+};
+
+// the largest pool that leaves a ring for the rest of n_need attended pages (n_need <= n_pages, page_ring < page_pool)
+static inline llama_kv_stream_split llama_kv_stream_split_budget(size_t budget, uint32_t n_pages, uint32_t n_need,
+        size_t page_pool, size_t page_ring) {
+    llama_kv_stream_split res;
+    if (n_need == 0 || page_pool <= page_ring) {
+        return res;
+    }
+    // n_need - 1 pool pages and a ring of one hold them all; with less the ring takes at least 2
+    if (budget >= (size_t) (n_need - 1)*page_pool + page_ring) {
+        res.n_slots = (uint32_t) std::min<size_t>(n_pages, (budget - page_ring)/page_pool);
+        res.n_ring  = 1;
+    } else if (budget > (size_t) n_need*page_ring) {
+        res.n_slots = (uint32_t) ((budget - (size_t) n_need*page_ring)/(page_pool - page_ring));
+        res.n_ring  = n_need - res.n_slots;
+    }
+    return res;
+}
+
+// One device buffer (the arena) holds the pool and the slots of a split, allocated once for the budget: a re-split places
+// the tensors anew inside it and neither frees nor allocates device memory. Freeing and reallocating instead does not keep
+// the device within the budget: the HIP runtime on Windows (ROCclr's PAL backend) keeps freed allocations below an
+// eighth of the VRAM in a cache that still counts as the process's dedicated memory, and reuses one only for a request
+// of more than half its size, so every slot buffer the slots outgrow stays allocated.
+//
+// Placing tensors one after the other at offsets aligned to `align`, each taking its size (the buffer type's alloc size)
+// rounded up to `align`, takes at most the sum of the sizes plus n_tensors*(align - 1). The sizes of a split's tensors
+// add up to split.bytes() plus the allocator's extra bytes per tensor (row padding, independent of the rows), so the
+// arena below holds every split of the budget.
+static inline size_t llama_kv_stream_pad(size_t bytes, size_t align) {
+    return (bytes + align - 1)/align*align;
+}
+
+// the budget an arena is sized for: no split ever takes more than every page of the context and one ring page
+static inline size_t llama_kv_stream_split_arena_budget(size_t budget, uint32_t n_pages, size_t page_pool, size_t page_ring) {
+    return std::min(budget, (size_t) n_pages*page_pool + page_ring);
+}
+
+// arena for a budget whose splits place n_tensors tensors (K and V of every layer in the pool, K and V of both slots)
+// that take `extra` bytes more in total than their data
+static inline size_t llama_kv_stream_split_arena_size(size_t budget, uint32_t n_tensors, size_t extra, size_t align) {
+    return budget + extra + (size_t) n_tensors*(align - 1);
+}
+
+// A chunked arena (LLAMA_KV_STREAM_POOL_CHUNK_MIB) is several regions, each its own device allocation, which no tensor
+// straddles: a tensor that does not fit the rest of a region goes to the start of the next one, leaving less than `waste`
+// (the largest tensor that can follow, plus the alignment) unused. Regions of `chunk` bytes, each but the last counted as
+// chunk - waste, hold any placement of `size` bytes. A region holds at least two of the largest tensors, so a tensor
+// never skips one. 0 = one region of `size` bytes
+static inline std::vector<size_t> llama_kv_stream_arena_regions(size_t size, size_t chunk, size_t waste, size_t align) {
+    if (chunk == 0 || size <= chunk) {
+        return { llama_kv_stream_pad(size, align) };
+    }
+    chunk = llama_kv_stream_pad(std::max(chunk, 2*waste), align);
+    std::vector<size_t> res;
+    while (size > chunk) {
+        res.push_back(chunk);
+        size -= chunk - waste;
+    }
+    res.push_back(llama_kv_stream_pad(size, align));
+    return res;
+}
+
+// the waste of a chunked split arena: a split places the slots first (at most slots_max bytes, slot_t_max per tensor),
+// then the pool tensors (at most pool_t_max each). Slots that fit the first region keep every region boundary among the
+// pool tensors, which are small (one layer)
+static inline size_t llama_kv_stream_split_arena_waste(size_t pool_t_max, size_t slots_max, size_t slot_t_max, size_t chunk,
+        size_t align) {
+    return (slots_max <= chunk ? pool_t_max : std::max(pool_t_max, slot_t_max)) + align;
+}
+
+// whether a split resize to `budget` keeps the arena that was sized for arena_budget (0: none): only a new budget (the
+// adaptive pool) replaces it, freeing the old one first
+static inline bool llama_kv_stream_split_keeps_arena(size_t arena_budget, size_t budget) {
+    return arena_budget > 0 && arena_budget == budget;
+}
+
+// bytes a split takes when placed in the arena from offset 0: the pool tensors (pool_page[i]: one page of pool tensor
+// i), then the slot tensors (ring_page[i]: one page of slot tensor i), each `extra_each` bytes larger than its data. (The
+// cache places the slots first, for chunked arenas; the padding bound is the same in either order.)
+static inline size_t llama_kv_stream_split_placed(const llama_kv_stream_split & s, const size_t * pool_page, uint32_t n_pool_t,
+        const size_t * ring_page, uint32_t n_ring_t, size_t extra_each, size_t align) {
+    size_t off = 0;
+    for (uint32_t i = 0; i < n_pool_t; ++i) {
+        off = llama_kv_stream_pad(off, align) + (size_t) s.n_slots*pool_page[i] + extra_each;
+    }
+    for (uint32_t i = 0; i < n_ring_t; ++i) {
+        off = llama_kv_stream_pad(off, align) + (size_t) s.n_ring*ring_page[i] + extra_each;
+    }
+    return off;
+}
+
+// whether a batch that attends n_att pages once placed (llama_kv_cache::kv_stream_pages_next) could stream more pages
+// than the slots hold. Checked before every batch, this keeps n_att <= n_slots + n_ring for every ubatch since the last
+// resize (which empties the pool). prepare() makes a page resident only below its ubatch's n_att, so every resident
+// page lies below n_slots + n_ring: pages past the current n_att that stayed resident after a sequence was cut (stale
+// pages) number at most n_slots + n_ring - n_att. Free slots always take attended pages, so either every attended page
+// is resident or the pool is full, and then at most n_att - (n_slots - stale) <= n_ring pages stream.
+static inline bool llama_kv_stream_split_outgrown(uint32_t n_att, uint32_t n_slots, uint32_t n_ring) {
+    return n_att > n_slots + n_ring;
+}
