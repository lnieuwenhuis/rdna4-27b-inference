+            // the cache has this split already, whatever asked for one: no rebuild
+            return true;
+        } else if (llama_kv_stream_split_outgrown(n_att, kv_stream->n_pool(), kv_stream->n_ring())) {
+            why_split = "the context outgrew the slots";
+        } else if (n_tok > cparams.n_tokens_decode && want.n_slots >= kv_stream->n_pool() + 32) {
